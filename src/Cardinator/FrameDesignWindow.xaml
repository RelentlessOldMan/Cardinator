<Window x:Class="Cardinator.FrameDesignWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Frame design" Height="820" Width="1000" MinHeight="600" MinWidth="860"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterOwner"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True" ShowInTaskbar="False">

    <Window.Resources>
        <!-- Compact controls scoped to this editor (the panel is dense). Disabled controls dim clearly. -->
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Padding" Value="7,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,1"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,1"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,2"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
            </Style.Triggers>
        </Style>
        <!-- Slim, clean slider: thin rounded track + small round thumb -->
        <Style TargetType="Slider">
            <Setter Property="Height" Value="20"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="4" CornerRadius="2" Background="#2EFFFFFF" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Opacity="0" Focusable="False" IsTabStop="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Opacity="0" Focusable="False" IsTabStop="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="14" Height="14" Fill="#EDEDF2" Stroke="#20000000" StrokeThickness="1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="22,16">
            <StackPanel>
                <TextBlock Text="Frame design" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Name}" Foreground="{StaticResource Subtle}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="Mix &amp; match — changes apply to this template." Foreground="{StaticResource Subtle}" FontSize="11" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="460"/>
                <ColumnDefinition Width="*" MinWidth="240"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="PreviewHost" Grid.Column="1" Background="{StaticResource PreviewBg}" ClipToBounds="True"
                    MouseWheel="OnPreviewWheel" MouseDown="OnPreviewPanDown"
                    MouseMove="OnPreviewPanMove" MouseUp="OnPreviewPanUp">
                <Grid>
                    <Canvas x:Name="LayoutCanvas" Width="450" Height="630" ClipToBounds="True"
                            Background="Black" Focusable="True" FocusVisualStyle="{x:Null}"
                            HorizontalAlignment="Left" VerticalAlignment="Top" RenderTransformOrigin="0,0"
                            MouseMove="OnCanvasMouseMove" MouseLeftButtonUp="OnCanvasMouseUp">
                        <Canvas.RenderTransform>
                            <MatrixTransform x:Name="ViewXform"/>
                        </Canvas.RenderTransform>
                        <Image x:Name="PreviewImage" Width="450" Height="630" Stretch="Fill"
                               RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True"/>
                    </Canvas>
                    <!-- Zoom readout + hint; never intercepts the wheel/drag. -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10"
                            Background="#AA000000" CornerRadius="4" Padding="8,3" IsHitTestVisible="False">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ZoomReadout" Text="100%" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="  ·  scroll zoom · middle-drag pan · F fit · B boxes"
                                       Foreground="#99FFFFFF" FontSize="11"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="18,14">
            <StackPanel Grid.IsSharedSizeScope="True">
                <TextBlock Text="Text &amp; layout" Style="{StaticResource SectionLabel}"/>
                <TextBlock Text="Drag a box on the preview to move it; drag an edge/corner to resize."
                           TextWrapping="Wrap" Foreground="{StaticResource Subtle}" FontSize="11" Margin="0,0,0,8"/>
                <CheckBox x:Name="ShowBoxesChk" Content="Show layout boxes" IsChecked="True" Margin="0,0,0,6"/>
                <CheckBox x:Name="FooterSingleChk" Content="Single-line footer" Margin="0,0,0,10"/>
                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock x:Name="SelRegionLabel" Text="Selected box: click one" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="X" VerticalAlignment="Center" Foreground="{StaticResource Subtle}" FontSize="11" Margin="0,0,3,0"/>
                            <TextBox   Grid.Column="1" x:Name="SelX" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="2" Text="Y" VerticalAlignment="Center" Foreground="{StaticResource Subtle}" FontSize="11" Margin="0,0,3,0"/>
                            <TextBox   Grid.Column="3" x:Name="SelY" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="4" Text="W" VerticalAlignment="Center" Foreground="{StaticResource Subtle}" FontSize="11" Margin="0,0,3,0"/>
                            <TextBox   Grid.Column="5" x:Name="SelW" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="6" Text="H" VerticalAlignment="Center" Foreground="{StaticResource Subtle}" FontSize="11" Margin="0,0,3,0"/>
                            <TextBox   Grid.Column="7" x:Name="SelH" Margin="0,0,8,0"/>
                        </Grid>
                        <Grid x:Name="SelFontPanel" Margin="0,8,0,0" IsEnabled="False">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="1.6*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Font " VerticalAlignment="Center" Foreground="{StaticResource Subtle}" FontSize="11"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="SelFontSize" Margin="0,0,8,0"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Color " VerticalAlignment="Center" Foreground="{StaticResource Subtle}" FontSize="11"/>
                            <TextBox Grid.Row="0" Grid.Column="3" x:Name="SelFontColor"/>
                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,6,0,0">
                                <CheckBox x:Name="SelBold" Content="Bold" Margin="0,0,10,0"/>
                                <CheckBox x:Name="SelItalic" Content="Italic" Margin="0,0,10,0"/>
                                <CheckBox x:Name="SelShadow" Content="Shadow"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Height="1" Background="{StaticResource Line}" Margin="0,14,0,10"/>
                <TextBlock Text="Card details" Style="{StaticResource SectionLabel}"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="CdLbl"/><ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Name " VerticalAlignment="Center" Foreground="{StaticResource Subtle}" FontSize="11"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" x:Name="NameBox"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Footer " VerticalAlignment="Center" Foreground="{StaticResource Subtle}" FontSize="11"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" x:Name="FooterPlacementBox"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Mana px " VerticalAlignment="Center" Foreground="{StaticResource Subtle}" FontSize="11"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="ManaSizeBox" Margin="0,1,8,1"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Rules px " VerticalAlignment="Center" Foreground="{StaticResource Subtle}" FontSize="11" Margin="0,0,3,0"/>
                    <TextBox Grid.Row="2" Grid.Column="3" x:Name="RulesSizeBox"/>
                </Grid>

                <Border x:Name="FrameFitPanel" Visibility="Collapsed" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Frame image — zoom / position / border" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="FitLbl"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="62"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="34"/><RowDefinition Height="34"/><RowDefinition Height="34"/><RowDefinition Height="34"/></Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Zoom " VerticalAlignment="Center" Foreground="{StaticResource Subtle}" FontSize="11"/>
                            <Slider Grid.Row="0" Grid.Column="1" x:Name="ZoomSlider" Minimum="0.5" Maximum="2.5" SmallChange="0.01" LargeChange="0.1" IsSnapToTickEnabled="False" Margin="4,0,8,0"/>
                            <TextBox Grid.Row="0" Grid.Column="2" x:Name="ZoomNum" VerticalAlignment="Center" TextAlignment="Center"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Offset X " VerticalAlignment="Center" Foreground="{StaticResource Subtle}" FontSize="11"/>
                            <Slider Grid.Row="1" Grid.Column="1" x:Name="OffXSlider" Minimum="-300" Maximum="300" Margin="4,0,8,0"/>
                            <TextBox Grid.Row="1" Grid.Column="2" x:Name="OffXNum" VerticalAlignment="Center" TextAlignment="Center"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Offset Y " VerticalAlignment="Center" Foreground="{StaticResource Subtle}" FontSize="11"/>
                            <Slider Grid.Row="2" Grid.Column="1" x:Name="OffYSlider" Minimum="-300" Maximum="300" Margin="4,0,8,0"/>
                            <TextBox Grid.Row="2" Grid.Column="2" x:Name="OffYNum" VerticalAlignment="Center" TextAlignment="Center"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Border " VerticalAlignment="Center" Foreground="{StaticResource Subtle}" FontSize="11"/>
                            <Slider Grid.Row="3" Grid.Column="1" x:Name="BorderSlider" Minimum="0" Maximum="80" Margin="4,0,8,0"/>
                            <TextBox Grid.Row="3" Grid.Column="2" x:Name="BorderNum" VerticalAlignment="Center" TextAlignment="Center"/>
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Border color " VerticalAlignment="Center" Foreground="{StaticResource Subtle}" FontSize="11"/>
                            <TextBox  Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" x:Name="FrameBorderColorBox" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </Grid>
                        <TextBlock Text="Zoom &gt;1 crops in; Offset Y + moves the art down (closes a bottom gap)." TextWrapping="Wrap" Foreground="{StaticResource Subtle}" FontSize="11" Margin="0,8,0,0"/>

                        <Border Height="1" Background="{StaticResource Line}" Margin="0,10,0,8"/>
                        <CheckBox x:Name="TranslucentChk" Content="Translucent mask (chroma key)" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="FitLbl"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="62"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="34"/><RowDefinition Height="34"/></Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Show-through " VerticalAlignment="Center" Foreground="{StaticResource Subtle}" FontSize="11"/>
                            <Slider Grid.Row="0" Grid.Column="1" x:Name="TranslucentSlider" Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1" IsSnapToTickEnabled="False" Margin="4,0,8,0"/>
                            <TextBox Grid.Row="0" Grid.Column="2" x:Name="TranslucentNum" VerticalAlignment="Center" TextAlignment="Center"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Key color " VerticalAlignment="Center" Foreground="{StaticResource Subtle}" FontSize="11"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="TranslucentKeyBox" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Backing " VerticalAlignment="Center" Foreground="{StaticResource Subtle}" FontSize="11"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" x:Name="TranslucentBackingBox" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </Grid>
                        <TextBlock Text="Paint the key color into the frame image where art should show through; show-through 1 = fully clear, 0 = opaque." TextWrapping="Wrap" Foreground="{StaticResource Subtle}" FontSize="11" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="CustomNote" Visibility="Collapsed" TextWrapping="Wrap"
                           Foreground="{StaticResource Subtle}" FontSize="11" Margin="0,0,0,8"
                           Text="Custom frame image: the greyed-out style knobs below don't apply. Use Text &amp; layout, Frame image (zoom/position/border), Card details, Corner/Panel radius, and Colors."/>

                <Border Height="1" Background="{StaticResource Line}" Margin="0,14,0,10"/>
                <TextBlock Text="Base style" Style="{StaticResource SectionLabel}"/>
                <ComboBox x:Name="StyleBox" Margin="0,0,0,8"/>

                <TextBlock Text="Toppers &amp; crown" Style="{StaticResource SectionLabel}"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock Text="Top emblem" Style="{StaticResource SectionLabel}"/>
                        <ComboBox x:Name="TopEmblemBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                        <TextBlock Text="Legendary crown" Style="{StaticResource SectionLabel}"/>
                        <ComboBox x:Name="CrownStyleBox"/>
                    </StackPanel>
                </Grid>
                <CheckBox x:Name="LegendaryCrownChk" Content="Show legendary crown (Legendary cards)" Margin="0,0,0,8"/>

                <TextBlock Text="Composable knobs" Style="{StaticResource SectionLabel}"/>
                <CheckBox x:Name="ConnectedChk" Content="Connected panels (two-tone hollow outline)" Margin="0,0,0,6"/>
                <CheckBox x:Name="BackgroundChk" Content="Textured colored background" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Bottom taper" VerticalAlignment="Center" Width="150" Foreground="{StaticResource Subtle}"/>
                    <ComboBox x:Name="TaperBox" Width="150"/>
                </StackPanel>
                <CheckBox x:Name="FadedChk" Content="Faded (melt art edges into frame)" Margin="0,0,0,6"/>
                <CheckBox x:Name="EmbellishChk" Content="Corner filigree (classic/ornate)" Margin="0,0,0,6"/>
                <CheckBox x:Name="PtBevelChk" Content="P/T box inner bevel" Margin="0,0,0,6"/>
                <CheckBox x:Name="RoyalChk" Content="Royal sub-border (ornate inner ring; insets all panels)" Margin="0,0,0,6"/>
                <CheckBox x:Name="FullArtChk" Content="Full art (text on the artwork)" Margin="0,0,0,8"/>

                <TextBlock Text="Texture &amp; border" Style="{StaticResource SectionLabel}"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock Text="Texture" Style="{StaticResource SectionLabel}"/>
                        <ComboBox x:Name="TextureBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                        <TextBlock Text="Texture strength (0–3)" Style="{StaticResource SectionLabel}"/>
                        <TextBox x:Name="TextureStrengthBox"/>
                    </StackPanel>
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                        <TextBlock Text="Border px" Style="{StaticResource SectionLabel}"/>
                        <TextBox x:Name="BorderBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="4,0,4,0">
                        <TextBlock Text="Sub-border px" Style="{StaticResource SectionLabel}"/>
                        <TextBox x:Name="SubBorderBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="4,0,4,0">
                        <TextBlock Text="Corner radius" Style="{StaticResource SectionLabel}"/>
                        <TextBox x:Name="CornerBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="4,0,0,0">
                        <TextBlock Text="Panel radius" Style="{StaticResource SectionLabel}"/>
                        <TextBox x:Name="PanelRadiusBox"/>
                    </StackPanel>
                </Grid>

                <Border Height="1" Background="{StaticResource Line}" Margin="0,14,0,10"/>
                <TextBlock Text="Colors (hex)" Style="{StaticResource SectionLabel}"/>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <!-- Column 1: border / frame / frame2 -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Border" VerticalAlignment="Center" Margin="0,3,8,3" Foreground="{StaticResource Subtle}" FontSize="11"/>
                    <TextBox  Grid.Row="0" Grid.Column="1" x:Name="ColBorder" Margin="0,3"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Frame" VerticalAlignment="Center" Margin="0,3,8,3" Foreground="{StaticResource Subtle}" FontSize="11"/>
                    <TextBox  Grid.Row="1" Grid.Column="1" x:Name="ColFrame" Margin="0,3"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Frame 2" VerticalAlignment="Center" Margin="0,3,8,3" Foreground="{StaticResource Subtle}" FontSize="11"/>
                    <TextBox  Grid.Row="2" Grid.Column="1" x:Name="ColFrame2" Margin="0,3"/>
                    <!-- Column 2: panel / panel border -->
                    <TextBlock Grid.Row="0" Grid.Column="3" Text="Panel" VerticalAlignment="Center" Margin="0,3,8,3" Foreground="{StaticResource Subtle}" FontSize="11"/>
                    <TextBox  Grid.Row="0" Grid.Column="4" x:Name="ColPanel" Margin="0,3"/>
                    <TextBlock Grid.Row="1" Grid.Column="3" Text="Panel border" VerticalAlignment="Center" Margin="0,3,8,3" Foreground="{StaticResource Subtle}" FontSize="11"/>
                    <TextBox  Grid.Row="1" Grid.Column="4" x:Name="ColPanelBorder" Margin="0,3"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="22,14">
            <Grid>
                <TextBlock x:Name="SaveStatus" HorizontalAlignment="Left" VerticalAlignment="Center"
                           FontWeight="SemiBold" Foreground="#5CCB7A" Opacity="0" Text=""/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelBtn" Content="Cancel" Style="{StaticResource Ghost}" MinWidth="90" Click="OnCancel"/>
                    <Button x:Name="ApplyBtn" Content="Apply" Style="{StaticResource Primary}" MinWidth="110" Margin="10,0,0,0" Click="OnApply"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

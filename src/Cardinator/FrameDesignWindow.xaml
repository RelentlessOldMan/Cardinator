<Window x:Class="Cardinator.FrameDesignWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Frame design" Height="760" Width="940" MinHeight="560" MinWidth="780"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterOwner"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True" ShowInTaskbar="False">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="22,16">
            <StackPanel>
                <TextBlock Text="Frame design" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Name}" Foreground="{StaticResource Subtle}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="Mix &amp; match — changes apply to this template." Foreground="{StaticResource Subtle}" FontSize="11" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="500"/>
                <ColumnDefinition Width="*" MinWidth="240"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="1" Background="{StaticResource PreviewBg}" Margin="0,0,0,0">
                <Image x:Name="PreviewImage" Stretch="Uniform" Margin="16"
                       RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True"/>
            </Border>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="22,18">
            <StackPanel>
                <TextBlock Text="Base style" Style="{StaticResource SectionLabel}"/>
                <ComboBox x:Name="StyleBox" Margin="0,0,0,12"/>

                <TextBlock Text="Toppers &amp; crown" Style="{StaticResource SectionLabel}"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock Text="Top emblem" Style="{StaticResource SectionLabel}"/>
                        <ComboBox x:Name="TopEmblemBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                        <TextBlock Text="Legendary crown" Style="{StaticResource SectionLabel}"/>
                        <ComboBox x:Name="CrownStyleBox"/>
                    </StackPanel>
                </Grid>
                <CheckBox x:Name="LegendaryCrownChk" Content="Show legendary crown (Legendary cards)" Margin="0,0,0,12"/>

                <TextBlock Text="Composable knobs" Style="{StaticResource SectionLabel}"/>
                <CheckBox x:Name="ConnectedChk" Content="Connected panels (two-tone hollow outline)" Margin="0,0,0,6"/>
                <CheckBox x:Name="BackgroundChk" Content="Textured colored background" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Bottom taper" VerticalAlignment="Center" Width="150" Foreground="{StaticResource Subtle}"/>
                    <ComboBox x:Name="TaperBox" Width="150"/>
                </StackPanel>
                <CheckBox x:Name="FadedChk" Content="Faded (melt art edges into frame)" Margin="0,0,0,6"/>
                <CheckBox x:Name="EmbellishChk" Content="Corner filigree (classic/ornate)" Margin="0,0,0,6"/>
                <CheckBox x:Name="PtBevelChk" Content="P/T box inner bevel" Margin="0,0,0,6"/>
                <CheckBox x:Name="RoyalChk" Content="Royal sub-border (ornate inner ring; insets all panels)" Margin="0,0,0,6"/>
                <CheckBox x:Name="FullArtChk" Content="Full art (text on the artwork)" Margin="0,0,0,12"/>

                <TextBlock Text="Texture &amp; border" Style="{StaticResource SectionLabel}"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock Text="Texture" Style="{StaticResource SectionLabel}"/>
                        <ComboBox x:Name="TextureBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                        <TextBlock Text="Texture strength (0–3)" Style="{StaticResource SectionLabel}"/>
                        <TextBox x:Name="TextureStrengthBox"/>
                    </StackPanel>
                </Grid>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                        <TextBlock Text="Border px" Style="{StaticResource SectionLabel}"/>
                        <TextBox x:Name="BorderBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="4,0,4,0">
                        <TextBlock Text="Corner radius" Style="{StaticResource SectionLabel}"/>
                        <TextBox x:Name="CornerBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="4,0,0,0">
                        <TextBlock Text="Panel radius" Style="{StaticResource SectionLabel}"/>
                        <TextBox x:Name="PanelRadiusBox"/>
                    </StackPanel>
                </Grid>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock Text="Royal sub-border px" Style="{StaticResource SectionLabel}"/>
                        <TextBox x:Name="SubBorderBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="6,0,0,0"/>
                </Grid>

                <TextBlock Text="Colors (hex)" Style="{StaticResource SectionLabel}"/>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Border" VerticalAlignment="Center" Margin="0,3,10,3" Foreground="{StaticResource Subtle}"/>
                    <TextBox  Grid.Row="0" Grid.Column="1" x:Name="ColBorder" Margin="0,3"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Frame" VerticalAlignment="Center" Margin="0,3,10,3" Foreground="{StaticResource Subtle}"/>
                    <TextBox  Grid.Row="1" Grid.Column="1" x:Name="ColFrame" Margin="0,3"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Frame 2" VerticalAlignment="Center" Margin="0,3,10,3" Foreground="{StaticResource Subtle}"/>
                    <TextBox  Grid.Row="2" Grid.Column="1" x:Name="ColFrame2" Margin="0,3"/>
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Panel" VerticalAlignment="Center" Margin="0,3,10,3" Foreground="{StaticResource Subtle}"/>
                    <TextBox  Grid.Row="3" Grid.Column="1" x:Name="ColPanel" Margin="0,3"/>
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Panel border" VerticalAlignment="Center" Margin="0,3,10,3" Foreground="{StaticResource Subtle}"/>
                    <TextBox  Grid.Row="4" Grid.Column="1" x:Name="ColPanelBorder" Margin="0,3"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="22,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource Ghost}" MinWidth="90" Click="OnCancel" IsCancel="True"/>
                <Button Content="Apply" Style="{StaticResource Primary}" MinWidth="110" Margin="10,0,0,0" Click="OnApply" IsDefault="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

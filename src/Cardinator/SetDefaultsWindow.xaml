<Window x:Class="Cardinator.SetDefaultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set defaults" SizeToContent="Height" Width="430" MinWidth="380"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">
    <StackPanel Margin="22,20">
        <TextBlock Text="Set defaults" FontSize="15" FontWeight="SemiBold"/>
        <TextBlock Text="The set's house defaults. New and imported cards inherit these for any field they don't already have — so you don't retype them per card."
                   Foreground="{StaticResource Subtle}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,14"/>

        <TextBlock Text="Set code" Style="{StaticResource SectionLabel}"/>
        <TextBox x:Name="SetBox" Height="34" Margin="0,2,0,10"/>

        <TextBlock Text="Artist" Style="{StaticResource SectionLabel}"/>
        <TextBox x:Name="ArtistBox" Height="34" Margin="0,2,0,10"/>

        <TextBlock Text="Copyright / footer" Style="{StaticResource SectionLabel}"/>
        <TextBox x:Name="CopyrightBox" Height="34" Margin="0,2,0,10"/>

        <TextBlock Text="Set symbol image (whole set shares it)" Style="{StaticResource SectionLabel}"/>
        <Grid Margin="0,2,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="SetSymbolBox" Height="34"/>
            <Button Grid.Column="1" Content="Browse…" Style="{StaticResource Ghost}" Click="OnBrowseSymbol" Margin="6,0,0,0"/>
        </Grid>

        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                <TextBlock Text="Rarity" Style="{StaticResource SectionLabel}"/>
                <ComboBox x:Name="RarityBox" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                <TextBlock Text="Default frame" Style="{StaticResource SectionLabel}"/>
                <ComboBox x:Name="FrameBox" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>

        <CheckBox x:Name="ApplyExistingBox" Content="Also apply to cards already in the set"
                  Margin="2,16,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" Style="{StaticResource Ghost}" MinWidth="90" Click="OnCancel" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Save defaults" Style="{StaticResource Primary}" MinWidth="110" Click="OnApply" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>

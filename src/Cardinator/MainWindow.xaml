<Window x:Class="Cardinator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cardinator"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="820" Width="1240" MinHeight="640" MinWidth="1040"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True"
        AllowDrop="True" DragOver="OnPreviewDragOver" Drop="OnWindowDrop"
        PreviewKeyDown="OnKeyDown" Closing="OnWindowClosing">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <Grid Margin="18,0" Height="52">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Cardinator" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding AppVersion}" Foreground="{StaticResource Subtle}" FontSize="12"
                               Margin="7,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ProjectSummary}" Foreground="{StaticResource Subtle}" FontSize="12"
                               Margin="14,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Undo" Style="{StaticResource Ghost}" Click="OnUndo" IsEnabled="{Binding CanUndo}" ToolTip="Undo (Ctrl+Z)" MinWidth="62" Margin="0,0,6,0"/>
                    <Button Content="Redo" Style="{StaticResource Ghost}" Click="OnRedo" IsEnabled="{Binding CanRedo}" ToolTip="Redo (Ctrl+Y)" MinWidth="62"/>
                    <Border Width="1" Background="{StaticResource Line}" Margin="10,10"/>
                    <Button Content="New" Style="{StaticResource Ghost}" Click="OnNewProject" IsEnabled="{Binding NotBusy}" ToolTip="New project (Ctrl+N)" MinWidth="62" Margin="0,0,6,0"/>
                    <Button Content="Open" Style="{StaticResource Ghost}" Click="OnOpenProject" IsEnabled="{Binding NotBusy}" ToolTip="Open project (Ctrl+O)" MinWidth="62" Margin="0,0,6,0"/>
                    <Button Content="Save" Style="{StaticResource Ghost}" Click="OnSaveProject" ToolTip="Save project (Ctrl+S)" MinWidth="62" Margin="0,0,6,0"/>
                    <Button Content="Restore…" Style="{StaticResource Ghost}" Click="OnRestoreBackup" IsEnabled="{Binding NotBusy}" ToolTip="Restore an earlier automatic backup of this set" MinWidth="62" Margin="0,0,6,0"/>
                    <Button Content="Help" Style="{StaticResource Ghost}" Click="OnHelp" ToolTip="Quick help (F1)" MinWidth="62"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="14">
            <Grid.ColumnDefinitions>
                <!-- Star-sized so the panels grow to fill the window when maximized (no more dead
                     whitespace on the sides). The sidebar is capped so it doesn't get absurdly wide. -->
                <ColumnDefinition Width="1.1*" MinWidth="270" MaxWidth="440"/>
                <ColumnDefinition Width="1.8*" MinWidth="400"/>
                <ColumnDefinition Width="2.3*" MinWidth="360"/>
            </Grid.ColumnDefinitions>

            <!-- ===== Sidebar: cards + batch ===== -->
            <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="10" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="CARDS" Style="{StaticResource SectionLabel}"/>
                    <UniformGrid DockPanel.Dock="Top" Columns="3" Margin="0,0,0,6">
                        <Button Content="Add" Click="OnAddCard" Margin="0,0,4,0" Padding="4,0" IsEnabled="{Binding NotBusy}"/>
                        <Button Content="Duplicate" Click="OnDuplicateCard" Margin="2,0,2,0" Padding="4,0" IsEnabled="{Binding CanEditSelected}"/>
                        <Button Content="Delete" Click="OnDeleteCard" Margin="4,0,0,0" Padding="4,0" IsEnabled="{Binding CanEditSelected}"/>
                    </UniformGrid>
                    <UniformGrid DockPanel.Dock="Top" Columns="2" Margin="0,0,0,8">
                        <Button Content="Move ↑" Click="OnMoveUp" Margin="0,0,4,0" IsEnabled="{Binding CanEditSelected}" ToolTip="Move the selected card(s) up"/>
                        <Button Content="Move ↓" Click="OnMoveDown" Margin="4,0,0,0" IsEnabled="{Binding CanEditSelected}" ToolTip="Move the selected card(s) down"/>
                    </UniformGrid>

                    <StackPanel DockPanel.Dock="Bottom">
                        <Border Height="1" Background="{StaticResource Line}" Margin="0,10"/>
                        <TextBlock Text="BATCH" Style="{StaticResource SectionLabel}"/>
                        <Button Content="Import file…" Click="OnImport" Margin="0,0,0,6" IsEnabled="{Binding NotBusy}"
                                ToolTip="Import a .txt/.csv/.tsv card list — including a Moxfield deck saved as a .txt"/>
                        <Button Content="Import deck…" Click="OnImportDeckList" Margin="0,0,0,6" IsEnabled="{Binding NotBusy}"
                                ToolTip="Fetch a Moxfield deck by link, or paste an exported list (Moxfield ⋯ More → Export, Archidekt, MTGGoldfish, plain text)"/>
                        <Button Content="Scryfall search…" Click="OnScryfallSearch" Margin="0,0,0,6" IsEnabled="{Binding NotBusy}"
                                ToolTip="Import many cards from a Scryfall search (with art)"/>
                        <Button Content="Add art from folder…" Click="OnMatchArtFolder" Margin="0,0,0,6" IsEnabled="{Binding CanExport}"
                                ToolTip="Attach images from a folder to cards by matching filename to card name"/>
                        <Button Content="Fill blanks from Scryfall" Click="OnLookupMissing" Margin="0,0,0,6" IsEnabled="{Binding CanExport}"
                                ToolTip="Fetch mana cost, type, rules text and art for cards that don't have them yet"/>
                        <Button Content="Number cards" Click="OnNumberCards" Margin="0,0,0,6" IsEnabled="{Binding CanExport}"
                                ToolTip="Assign collector numbers (001/N …) in list order"/>
                        <Button Content="Check all cards" Click="OnCheckAll" Margin="0,0,0,6" IsEnabled="{Binding CanExport}"
                                ToolTip="Run the checks across the whole set and list every card that needs attention"/>
                        <Button Content="Set defaults…" Click="OnSetDefaults" Margin="0,0,0,6"
                                ToolTip="The set's house defaults (set code / rarity / copyright / artist / symbol / frame) that new and imported cards inherit"/>
                        <Button Content="Set fields on all…" Click="OnBulkEdit" Margin="0,0,0,6" IsEnabled="{Binding CanExport}"
                                ToolTip="Set the same set code / artist / rarity / copyright / frame on every card"/>
                        <Button Content="Export all…" Click="OnExportAll" Margin="0,0,0,6" IsEnabled="{Binding CanExport}"/>
                        <Button Content="Print sheet…" Click="OnExportSheet" Margin="0,0,0,6" IsEnabled="{Binding CanExport}"/>
                        <Button Content="Share set + frames…" Click="OnExportSetBundle" IsEnabled="{Binding CanExport}"
                                ToolTip="Zip the whole set (project + art + its custom frames) to send to someone else"/>
                    </StackPanel>

                    <Border Background="{StaticResource Bg}" CornerRadius="8" Padding="4">
                        <ListBox x:Name="CardList" ItemsSource="{Binding Cards}" SelectedItem="{Binding SelectedCard}"
                                 SelectionMode="Extended" DisplayMemberPath="Name"/>
                    </Border>
                </DockPanel>
            </Border>

            <!-- ===== Editor (simple flow) ===== -->
            <Border Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="10" Padding="18" Margin="14,0">
                <StackPanel IsEnabled="{Binding CanEditSelected}">
                    <TextBlock Text="CARD NAME" Style="{StaticResource SectionLabel}"/>
                    <!-- Just the name — this is YOUR card's title. To pull real stats from Scryfall (even for a
                         card with a different name), use the search inside Edit details…. -->
                    <TextBox Height="36" Margin="0,0,0,14" Text="{Binding SelectedCard.Name, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="FRAME" Style="{StaticResource SectionLabel}"/>
                    <!-- Dropdown on its own row so long frame names aren't truncated; the action buttons
                         sit in an equal-width row beneath it (UniformGrid = identical column widths). -->
                    <StackPanel Margin="0,0,0,14">
                        <ComboBox ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}"
                                  DisplayMemberPath="Name" Margin="0,0,0,8"/>
                        <UniformGrid Rows="1" Columns="4">
                            <Button Content="Design…" Style="{StaticResource Ghost}" Click="OnFrameDesign"
                                    Margin="0,0,3,0" ToolTip="Mix &amp; match frame knobs (style, connected panels, background, taper, top emblem, colors…)"/>
                            <Button Content="Import…" Style="{StaticResource Ghost}" Click="OnImportFrame"
                                    Margin="3,0,3,0" ToolTip="Import a frame: pick a PNG, a .cardframe, or a .zip bundle from your PC — or paste a web link"/>
                            <Button Content="Export…" Style="{StaticResource Ghost}" Click="OnExportTemplate"
                                    Margin="3,0,3,0" ToolTip="Save this template as a shareable bundle (.cardframe = frame.png + its settings)"/>
                            <Button x:Name="DeleteFrameBtn" Content="Delete…" Style="{StaticResource Ghost}" Click="OnDeleteFrame"
                                    Margin="3,0,0,0" ToolTip="Delete the selected frame (your own frames only — built-in frames can't be deleted)"/>
                        </UniformGrid>
                    </StackPanel>

                    <TextBlock Text="ARTWORK" Style="{StaticResource SectionLabel}"/>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Change art…" Click="OnLoadArt"/>
                        <Button Grid.Column="1" Content="Paste" Click="OnPasteArt" Margin="6,0,0,0"
                                ToolTip="Paste an image, a copied image file, or an image URL from the clipboard"/>
                        <Button Grid.Column="2" Content="Clear" Style="{StaticResource Ghost}" Click="OnClearArt" Margin="6,0,0,0"/>
                    </Grid>
                    <TextBlock Text="Drop an image anywhere · drag the preview to pan · scroll to zoom" Foreground="{StaticResource Subtle}"
                               FontSize="11" Margin="2,0,0,18"/>

                    <Button Content="Edit details…" Click="OnEditDetails" Margin="0,0,0,16"/>

                    <TextBlock Text="DOUBLE-FACED" Style="{StaticResource SectionLabel}"/>
                    <StackPanel Margin="0,0,0,16">
                        <UniformGrid Rows="1" Columns="2" Margin="0,0,0,8">
                            <Button x:Name="DfcToggleBtn" Content="Make double-faced" Click="OnToggleDfc" Margin="0,0,3,0"
                                    ToolTip="Add or remove a back face (a front/back card that flips)"/>
                            <Button x:Name="DfcEditBackBtn" Content="Edit back face…" Click="OnEditBackFace" Margin="3,0,0,0"
                                    ToolTip="Edit the back face's fields and art"/>
                        </UniformGrid>
                        <UniformGrid Rows="1" Columns="2">
                            <Button x:Name="DfcFlipBtn" Content="Show back" Click="OnFlipPreview" Margin="0,0,3,0"
                                    ToolTip="Flip the preview between the front and back face"/>
                            <ComboBox x:Name="DfcStyleBox" Margin="3,0,0,0" SelectionChanged="OnDfcStyleChanged"
                                      ToolTip="Corner indicator drawn on a double-faced card"/>
                        </UniformGrid>
                    </StackPanel>

                    <TextBlock Text="FLIP CARD" Style="{StaticResource SectionLabel}"/>
                    <StackPanel Margin="0,0,0,16">
                        <UniformGrid Rows="1" Columns="2" Margin="0,0,0,8">
                            <Button x:Name="FlipToggleBtn" Content="Make flip card" Click="OnToggleFlip" Margin="0,0,3,0"
                                    ToolTip="Add or remove a flipped half (a Kamigawa flip card: the other half is printed upside down below the art)"/>
                            <Button x:Name="FlipEditBtn" Content="Edit flipped half…" Click="OnEditFlippedHalf" Margin="3,0,0,0"
                                    ToolTip="Edit the upside-down half's name, type, rules and power/toughness"/>
                        </UniformGrid>
                        <Button x:Name="FlipShowBtn" Content="Show flipped" Click="OnShowFlipped"
                                ToolTip="Turn the preview upside down to read the flipped half"/>
                    </StackPanel>

                    <TextBlock Text="CHECKS" Style="{StaticResource SectionLabel}"/>
                    <Border Background="{StaticResource Bg}" CornerRadius="8" Padding="10,8" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{Binding ValidationSummary}" FontSize="12" Foreground="{StaticResource Subtle}"/>
                            <TextBlock Text="{Binding ValidationDetails}" FontSize="11" Foreground="{StaticResource Warn}" TextWrapping="Wrap"
                                       Margin="0,5,0,0" Visibility="{Binding HasValidationIssues, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Border>

                    <Button Content="Export PNG…" Click="OnExport"/>
                    <UniformGrid Columns="2" Margin="0,8,0,0">
                        <Button Content="Copy image" Click="OnCopyImage" Margin="0,0,4,0"
                                ToolTip="Copy the finished card image to the clipboard"/>
                        <Button Content="Open output folder" Click="OnOpenOutput" Margin="4,0,0,0"/>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- ===== Preview ===== -->
            <Border Grid.Column="2" Background="{StaticResource PreviewBg}" CornerRadius="10" Padding="18">
                <Grid>
                    <Image x:Name="PreviewImageControl" Source="{Binding PreviewImage}" Stretch="Uniform"
                           Focusable="True" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" Cursor="SizeAll"
                           MouseLeftButtonDown="OnPreviewMouseDown" MouseMove="OnPreviewMouseMove"
                           MouseLeftButtonUp="OnPreviewMouseUp" MouseWheel="OnPreviewWheel"
                           ToolTip="Drag to pan · scroll to zoom (Ctrl = fine) · click then arrow keys to nudge, +/- to zoom"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== Status bar (persistent; shows progress for any running operation) ===== -->
        <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                BorderThickness="0,1,0,0" Padding="16,7">
            <Grid>
                <TextBlock Text="{Binding Status}" Foreground="{StaticResource Subtle}" FontSize="12"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,170,0"/>
                <ProgressBar HorizontalAlignment="Right" VerticalAlignment="Center" Width="150" Height="6"
                             Minimum="0" Maximum="100" Value="{Binding ExportProgress}"
                             IsIndeterminate="{Binding ProgressIndeterminate}" Foreground="{StaticResource Accent}"
                             Background="{StaticResource ProgressTrack}" BorderThickness="0"
                             Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Border>
    </Grid>
</Window>

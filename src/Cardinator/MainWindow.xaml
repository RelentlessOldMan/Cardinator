<Window x:Class="Cardinator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cardinator"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="820" Width="1240" MinHeight="640" MinWidth="1040"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True"
        AllowDrop="True" DragOver="OnPreviewDragOver" Drop="OnWindowDrop"
        PreviewKeyDown="OnKeyDown" Closing="OnWindowClosing">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <Grid Margin="18,0" Height="52">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Cardinator" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding AppVersion}" Foreground="{StaticResource Subtle}" FontSize="12"
                               Margin="7,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ProjectSummary}" Foreground="{StaticResource Subtle}" FontSize="12"
                               Margin="14,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Undo" Style="{StaticResource Ghost}" Click="OnUndo" IsEnabled="{Binding CanUndo}" ToolTip="Undo (Ctrl+Z)" MinWidth="62" Margin="0,0,6,0"/>
                    <Button Content="Redo" Style="{StaticResource Ghost}" Click="OnRedo" IsEnabled="{Binding CanRedo}" ToolTip="Redo (Ctrl+Y)" MinWidth="62"/>
                    <Border Width="1" Background="{StaticResource Line}" Margin="10,10"/>
                    <Button Content="New" Style="{StaticResource Ghost}" Click="OnNewProject" IsEnabled="{Binding NotBusy}" ToolTip="New project (Ctrl+N)" MinWidth="62" Margin="0,0,6,0"/>
                    <Button Content="Open" Style="{StaticResource Ghost}" Click="OnOpenProject" IsEnabled="{Binding NotBusy}" ToolTip="Open project (Ctrl+O)" MinWidth="62" Margin="0,0,6,0"/>
                    <Button Content="Save" Style="{StaticResource Ghost}" Click="OnSaveProject" ToolTip="Save project (Ctrl+S)" MinWidth="62" Margin="0,0,6,0"/>
                    <Button Content="Restore…" Style="{StaticResource Ghost}" Click="OnRestoreBackup" IsEnabled="{Binding NotBusy}" ToolTip="Restore an earlier automatic backup of this set" MinWidth="62" Margin="0,0,6,0"/>
                    <Button Content="Help" Style="{StaticResource Ghost}" Click="OnHelp" ToolTip="Quick help (F1)" MinWidth="62"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="14">
            <Grid.ColumnDefinitions>
                <!-- Star-sized so the panels grow to fill the window when maximized (no more dead
                     whitespace on the sides). The sidebar is capped so it doesn't get absurdly wide. -->
                <ColumnDefinition Width="1.1*" MinWidth="270" MaxWidth="440"/>
                <ColumnDefinition Width="1.8*" MinWidth="400"/>
                <ColumnDefinition Width="2.3*" MinWidth="360"/>
            </Grid.ColumnDefinitions>

            <!-- ===== Sidebar: cards + batch ===== -->
            <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="10" Padding="12">
                <!-- When the window is short (or the display scaled up), the BATCH buttons scroll rather than squeezing
                     the card list below one row (OnSidebarSizeChanged keeps the list at least a few rows tall). -->
                <DockPanel x:Name="Sidebar" SizeChanged="OnSidebarSizeChanged">
                    <TextBlock DockPanel.Dock="Top" Text="CARDS" Style="{StaticResource SectionLabel}"/>
                    <UniformGrid DockPanel.Dock="Top" Columns="3" Margin="0,0,0,6">
                        <Button x:Name="NewCardBtn" Content="New card ▾" Click="OnNewCardMenu" Margin="0,0,4,0" Padding="4,0" IsEnabled="{Binding NotBusy}"
                                ToolTip="Add a blank card or a token">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Blank card" Click="OnAddCard"/>
                                    <MenuItem Header="Token (a 1/1 Soldier to start)" Click="OnAddToken"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button Content="Duplicate" Click="OnDuplicateCard" Margin="2,0,2,0" Padding="4,0" IsEnabled="{Binding CanEditSelected}"
                                ToolTip="Add a copy of this card after it (Ctrl+D)"/>
                        <Button Content="Delete" Click="OnDeleteCard" Margin="4,0,0,0" Padding="4,0" IsEnabled="{Binding CanEditSelected}"
                                ToolTip="Delete the selected card(s) — Undo (Ctrl+Z) brings them back"/>
                    </UniformGrid>
                    <UniformGrid DockPanel.Dock="Top" Columns="2" Margin="0,0,0,8">
                        <Button Content="Move up" Click="OnMoveUp" Margin="0,0,3,0" IsEnabled="{Binding CanEditSelected}" ToolTip="Move the selected card(s) up the list"/>
                        <Button Content="Move down" Click="OnMoveDown" Margin="3,0,0,0" IsEnabled="{Binding CanEditSelected}" ToolTip="Move the selected card(s) down the list"/>
                    </UniformGrid>

                    <ScrollViewer x:Name="BatchScroll" DockPanel.Dock="Bottom" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel>
                        <Border Height="1" Background="{StaticResource Line}" Margin="0,10"/>
                        <TextBlock Text="ADD MANY CARDS" Style="{StaticResource SectionLabel}"/>
                        <UniformGrid Columns="2" Margin="0,0,0,6">
                            <Button Content="Import cards…" Click="OnImportDeckList" Margin="0,0,3,0" Padding="4,0" IsEnabled="{Binding NotBusy}"
                                    ToolTip="A Moxfield deck from its link, a list file (.txt, .csv, .tsv), or a pasted list — each card filled in from Scryfall"/>
                            <Button Content="Search Scryfall…" Click="OnScryfallSearch" Margin="3,0,0,0" Padding="4,0" IsEnabled="{Binding NotBusy}"
                                    ToolTip="Search Scryfall and add the cards you tick, with their art"/>
                        </UniformGrid>
                        <Button Content="Add art from a folder…" Click="OnMatchArtFolder" Margin="0,0,0,6" IsEnabled="{Binding CanExport}"
                                ToolTip="Give cards the pictures in a folder whose file names match the card names"/>
                        <Button Content="Fill in blanks from Scryfall" Click="OnLookupMissing" Margin="0,0,0,6" IsEnabled="{Binding CanExport}"
                                ToolTip="Look up the cost, type, rules text and art of every card that's missing them"/>

                        <TextBlock Text="WHOLE SET" Style="{StaticResource SectionLabel}" Margin="2,8,0,4"/>
                        <Button Content="Set settings…" Click="OnSetSettings" Margin="0,0,0,6"
                                ToolTip="What every card in the set shares: set code, rarity, artist, copyright, set symbol, the frame for new cards, and the card back"/>
                        <UniformGrid Columns="2" Margin="0,0,0,6">
                            <Button Content="Number cards" Click="OnNumberCards" Margin="0,0,3,0" Padding="4,0" IsEnabled="{Binding CanExport}"
                                    ToolTip="Give every card a collector number (001/120 …) in list order"/>
                            <Button Content="Check all cards" Click="OnCheckAll" Margin="3,0,0,0" Padding="4,0" IsEnabled="{Binding CanExport}"
                                    ToolTip="Run the checks on every card and list the ones that need attention"/>
                        </UniformGrid>

                        <TextBlock Text="EXPORT" Style="{StaticResource SectionLabel}" Margin="2,8,0,4"/>
                        <UniformGrid Columns="2" Margin="0,0,0,6">
                            <Button Content="All as images…" Click="OnExportAll" Margin="0,0,3,0" Padding="4,0" IsEnabled="{Binding CanExport}"
                                    ToolTip="Save every card as a PNG in a folder"/>
                            <Button Content="Print sheets…" Click="OnExportSheet" Margin="3,0,0,0" Padding="4,0" IsEnabled="{Binding CanExport}"
                                    ToolTip="Pages of cards ready to print and cut — with their backs, for double-sided printing"/>
                        </UniformGrid>
                        <Button Content="Share the set…" Click="OnExportSetBundle" IsEnabled="{Binding CanExport}"
                                ToolTip="One .zip with the set, its art and its frames, to send to someone else"/>
                    </StackPanel>
                    </ScrollViewer>

                    <Border Background="{StaticResource Bg}" CornerRadius="8" Padding="4">
                        <ListBox x:Name="CardList" ItemsSource="{Binding Cards}" SelectedItem="{Binding SelectedCard}"
                                 SelectionMode="Extended" DisplayMemberPath="Name"/>
                    </Border>
                </DockPanel>
            </Border>

            <!-- ===== Editor (simple flow) ===== -->
            <Border Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="10" Padding="18,18,6,18" Margin="14,0">
                <!-- Scrolls when the window is too short for it all, so CHECKS and Export are never cut off. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel IsEnabled="{Binding CanEditSelected}" Margin="0,0,12,0">
                    <!-- Shown instead of the card's fields while the preview shows the set's card back. -->
                    <Border x:Name="CardBackNote" Background="{StaticResource Bg}" CornerRadius="8" Padding="12,10" Margin="0,0,0,14"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="This is the back of the card — the set's card back, which every card without a back face of its own shares."
                                       TextWrapping="Wrap" Foreground="{StaticResource Subtle}" FontSize="12" Margin="0,0,0,8"/>
                            <Button Content="Change the card back…" Click="OnChangeCardBack" HorizontalAlignment="Left"
                                    ToolTip="Opens Set settings, where the card back is chosen"/>
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="FaceEditor">
                    <TextBlock x:Name="NameLabel" Text="CARD NAME" Style="{StaticResource SectionLabel}"/>
                    <!-- Just the name of the side being edited (Front | Back above the preview picks it). To pull real
                         stats from Scryfall (even for a card with a different name), use the search inside Edit details…. -->
                    <TextBox x:Name="NameBox" Height="36" Margin="0,0,0,14" Text="{Binding EditedFace.Name, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="CARD LAYOUT" Style="{StaticResource SectionLabel}"/>
                    <StackPanel Margin="0,0,0,14">
                        <ComboBox x:Name="LayoutBox" SelectionChanged="OnLayoutChanged" PreviewKeyDown="OnLayoutKeyDown"
                                  ToolTip="What kind of card this is: one face, two faces, a meld half, two halves on one face, or a creature with an adventure"/>
                        <!-- The one row of options for the chosen layout. -->
                        <Grid x:Name="DfcOptions" Margin="0,8,0,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Corner mark" VerticalAlignment="Center" Foreground="{StaticResource Subtle}" FontSize="12" Margin="2,0,10,0"/>
                            <ComboBox x:Name="DfcStyleBox" Grid.Column="1" SelectionChanged="OnDfcStyleChanged"
                                      ToolTip="The little symbol in the corner that shows which face is which"/>
                        </Grid>
                        <Grid x:Name="MeldOptions" Margin="0,8,0,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Its back shows the" VerticalAlignment="Center" Foreground="{StaticResource Subtle}" FontSize="12" Margin="2,0,10,0"/>
                            <ComboBox x:Name="MeldHalfBox" Grid.Column="1" SelectionChanged="OnMeldHalfChanged"
                                      ToolTip="Which half of the melded card this card's back prints (its partner prints the other)"/>
                            <Button x:Name="MeldPartnerBtn" Grid.Column="2" Content="Add partner" Style="{StaticResource Ghost}" Click="OnAddMeldPartner"
                                    Margin="8,0,0,0" ToolTip="Add the card that melds with this one, right after it: its back prints the other half"/>
                        </Grid>
                        <Grid x:Name="HalfFramePanel" Margin="0,8,0,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="HalfFrameLabel" Text="Second half's frame" VerticalAlignment="Center" Foreground="{StaticResource Subtle}"
                                       FontSize="12" Margin="2,0,10,0"/>
                            <ComboBox x:Name="HalfFrameBox" Grid.Column="1" SelectionChanged="OnHalfFrameChanged"
                                      ToolTip="Give the second half a frame of its own (a red half and a white half), or keep the card's frame"/>
                        </Grid>
                        <TextBlock x:Name="LayoutHint" Margin="2,6,0,0" Foreground="{StaticResource Subtle}" FontSize="11" TextWrapping="Wrap"
                                   Visibility="Collapsed"/>
                    </StackPanel>

                    <TextBlock Text="FRAME" Style="{StaticResource SectionLabel}"/>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}" DisplayMemberPath="Name"/>
                        <Button Grid.Column="1" Content="Design…" Style="{StaticResource Ghost}" Click="OnFrameDesign" Margin="6,0,0,0"
                                ToolTip="Change this frame's style, colours, panels and text boxes — or make a new frame from it"/>
                        <Button x:Name="FrameMenuBtn" Grid.Column="2" Content="⋯" Style="{StaticResource Ghost}" Click="OnFrameMenu" Margin="6,0,0,0"
                                Padding="10,0" ToolTip="Import a frame, export this one, or delete it">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Import a frame…" Click="OnImportFrame"
                                              ToolTip="A PNG, a .cardframe or a .zip bundle from your PC — or a web link"/>
                                    <MenuItem Header="Export this frame…" Click="OnExportTemplate"
                                              ToolTip="Save this frame as a .cardframe file to share"/>
                                    <MenuItem Header="Delete this frame…" Click="OnDeleteFrame"
                                              ToolTip="Your own frames only — the built-in frames can't be deleted"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </Grid>

                    <TextBlock Text="ARTWORK" Style="{StaticResource SectionLabel}"/>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Change art…" Click="OnLoadArt"/>
                        <Button Grid.Column="1" Content="Paste" Click="OnPasteArt" Margin="6,0,0,0"
                                ToolTip="Paste an image, a copied image file, or an image URL from the clipboard"/>
                        <Button Grid.Column="2" Content="Reset" Style="{StaticResource Ghost}" Click="OnResetArt" Margin="6,0,0,0"
                                ToolTip="Put the art back where it started: centred, at its original size (or press 0 on the preview)"/>
                        <Button Grid.Column="3" Content="Clear" Style="{StaticResource Ghost}" Click="OnClearArt" Margin="6,0,0,0"/>
                    </Grid>
                    <TextBlock Text="Drop an image anywhere · drag the preview to pan · scroll to zoom" Foreground="{StaticResource Subtle}"
                               FontSize="11" Margin="2,0,0,18"/>

                    <Button x:Name="EditDetailsBtn" Content="Edit details…" Click="OnEditDetails" Margin="0,0,0,16"
                            ToolTip="Everything on this side of the card: cost, type, rules, power/toughness, rarity, set and artist — and a Scryfall lookup"/>
                    </StackPanel>

                    <StackPanel x:Name="FaceFooter">
                    <TextBlock Text="CHECKS" Style="{StaticResource SectionLabel}"/>
                    <Border Background="{StaticResource Bg}" CornerRadius="8" Padding="10,8" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{Binding ValidationSummary}" FontSize="12" Foreground="{StaticResource Subtle}"/>
                            <TextBlock Text="{Binding ValidationDetails}" FontSize="11" Foreground="{StaticResource Warn}" TextWrapping="Wrap"
                                       Margin="0,5,0,0" Visibility="{Binding HasValidationIssues, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="EXPORT THIS CARD" Style="{StaticResource SectionLabel}"/>
                    <Button Content="Export PNG…" Click="OnExport"/>
                    <UniformGrid Columns="2" Margin="0,8,0,0">
                        <Button Content="Copy image" Click="OnCopyImage" Margin="0,0,4,0"
                                ToolTip="Copy the finished card image to the clipboard"/>
                        <Button Content="Open output folder" Click="OnOpenOutput" Margin="4,0,0,0"/>
                    </UniformGrid>
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ===== Preview ===== -->
            <Border Grid.Column="2" Background="{StaticResource PreviewBg}" CornerRadius="10" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- Which side of the card is shown and edited; for a flip or split card, which half too. -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <WrapPanel HorizontalAlignment="Center">
                            <Border Style="{StaticResource SegmentBar}" Margin="4,0">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="FrontSeg" GroupName="Side" Style="{StaticResource Segment}" Content="Front" IsChecked="True"
                                                 Checked="OnSideChanged" ToolTip="Show and edit the front of the card"/>
                                    <RadioButton x:Name="BackSeg" GroupName="Side" Style="{StaticResource Segment}" Content="Back"
                                                 Checked="OnSideChanged" ToolTip="Show the back of the card: its back face, or the set's card back"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="HalfBar" Style="{StaticResource SegmentBar}" Margin="4,0" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="FirstHalfSeg" GroupName="Half" Style="{StaticResource Segment}" Content="Top half" IsChecked="True"
                                                 Checked="OnHalfChanged"/>
                                    <RadioButton x:Name="OtherHalfSeg" GroupName="Half" Style="{StaticResource Segment}" Content="Flipped half"
                                                 Checked="OnHalfChanged"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                        <CheckBox x:Name="SidewaysBox" Content="Read sideways" HorizontalAlignment="Center" Margin="0,8,0,0"
                                  Visibility="Collapsed" Checked="OnSidewaysChanged" Unchecked="OnSidewaysChanged"
                                  ToolTip="Turn the preview the way the halves are read"/>
                        <CheckBox x:Name="WholeMeldBox" Content="Show the whole melded card" HorizontalAlignment="Center" Margin="0,8,0,0"
                                  Visibility="Collapsed" Checked="OnWholeMeldChanged" Unchecked="OnWholeMeldChanged"
                                  ToolTip="Show the big melded card that this card's back and its partner's make together"/>
                    </StackPanel>
                    <TextBlock x:Name="PreviewHint" Grid.Row="2" HorizontalAlignment="Center" Margin="0,10,0,0" FontSize="11"
                               Foreground="{StaticResource Subtle}" TextWrapping="Wrap" TextAlignment="Center"
                               Text="Drag to pan · scroll to zoom · click the card for keys: arrows nudge, + / − zoom, 0 resets"/>
                    <Image x:Name="PreviewImageControl" Grid.Row="1" Source="{Binding PreviewImage}" Stretch="Uniform"
                           Focusable="True" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" Cursor="SizeAll"
                           MouseLeftButtonDown="OnPreviewMouseDown" MouseMove="OnPreviewMouseMove"
                           MouseLeftButtonUp="OnPreviewMouseUp" MouseWheel="OnPreviewWheel"
                           GotKeyboardFocus="OnPreviewFocusChanged" LostKeyboardFocus="OnPreviewFocusChanged"
                           ToolTip="Drag to pan · scroll to zoom (Ctrl = fine) · click then arrow keys to nudge, +/- to zoom, 0 to reset"/>
                    <!-- While the art is dragged or zoomed: the card as a live drawing (art + everything else drawn once), laid
                         exactly over the preview, so a move costs no repaint (RenderPreviewLive). -->
                    <Image x:Name="LiveArtImage" Grid.Row="1" Stretch="Uniform" IsHitTestVisible="False" Visibility="Collapsed"
                           RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== Status bar (persistent; shows progress for any running operation) ===== -->
        <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                BorderThickness="0,1,0,0" Padding="16,7">
            <Grid>
                <TextBlock Text="{Binding Status}" Foreground="{StaticResource Subtle}" FontSize="12"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,170,0"/>
                <ProgressBar HorizontalAlignment="Right" VerticalAlignment="Center" Width="150" Height="6"
                             Minimum="0" Maximum="100" Value="{Binding ExportProgress}"
                             IsIndeterminate="{Binding ProgressIndeterminate}" Foreground="{StaticResource Accent}"
                             Background="{StaticResource ProgressTrack}" BorderThickness="0"
                             Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Border>
    </Grid>
</Window>

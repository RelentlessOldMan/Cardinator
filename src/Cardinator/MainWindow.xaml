<Window x:Class="Cardinator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cardinator"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="820" Width="1240" MinHeight="640" MinWidth="1040"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True"
        AllowDrop="True" DragOver="OnPreviewDragOver" Drop="OnWindowDrop"
        PreviewKeyDown="OnKeyDown" Closing="OnWindowClosing">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <Grid Margin="18,0" Height="52">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="◆" Foreground="{StaticResource Accent}" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock Text="Cardinator" FontSize="17" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ProjectSummary}" Foreground="{StaticResource Subtle}" FontSize="12"
                               Margin="14,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="New" Style="{StaticResource Ghost}" Click="OnNewProject"/>
                    <Button Content="Open" Style="{StaticResource Ghost}" Click="OnOpenProject"/>
                    <Button Content="Save" Style="{StaticResource Ghost}" Click="OnSaveProject"/>
                    <Button Content="Help" Style="{StaticResource Ghost}" Click="OnHelp" ToolTip="Quick help (F1)"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="14" MaxWidth="1600">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270"/>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="*" MinWidth="360"/>
            </Grid.ColumnDefinitions>

            <!-- ===== Sidebar: cards + batch ===== -->
            <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="10" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="CARDS" Style="{StaticResource SectionLabel}"/>
                    <UniformGrid DockPanel.Dock="Top" Columns="3" Margin="0,0,0,8">
                        <Button Content="Add" Click="OnAddCard" Margin="0,0,4,0"/>
                        <Button Content="Copy" Click="OnDuplicateCard" Margin="2,0,2,0"/>
                        <Button Content="Delete" Click="OnDeleteCard" Margin="4,0,0,0"/>
                    </UniformGrid>

                    <StackPanel DockPanel.Dock="Bottom">
                        <Border Height="1" Background="{StaticResource Line}" Margin="0,10"/>
                        <TextBlock Text="BATCH" Style="{StaticResource SectionLabel}"/>
                        <Button Content="Import list / CSV…" Click="OnImport" Margin="0,0,0,6"/>
                        <Button Content="Scryfall search…" Click="OnScryfallSearch" Margin="0,0,0,6"
                                ToolTip="Import many cards from a Scryfall search (with art)"/>
                        <Button Content="Match art folder…" Click="OnMatchArtFolder" Margin="0,0,0,6"/>
                        <Button Content="Look up missing" Click="OnLookupMissing" Margin="0,0,0,6"/>
                        <Button Content="Export all…" Click="OnExportAll" Margin="0,0,0,6"/>
                        <Button Content="Print sheet…" Click="OnExportSheet"/>
                    </StackPanel>

                    <Border Background="{StaticResource Bg}" CornerRadius="8" Padding="4">
                        <ListBox x:Name="CardList" ItemsSource="{Binding Cards}" SelectedItem="{Binding SelectedCard}"
                                 DisplayMemberPath="Name"/>
                    </Border>
                </DockPanel>
            </Border>

            <!-- ===== Editor (simple flow) ===== -->
            <Border Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="10" Padding="18" Margin="14,0">
                <StackPanel IsEnabled="{Binding HasSelection}">
                    <TextBlock Text="CARD NAME" Style="{StaticResource SectionLabel}"/>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Height="36" Text="{Binding SelectedCard.Name, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="1" Content="Search" Style="{StaticResource Primary}" Margin="8,0,0,0"
                                Height="36" MinWidth="94" Click="OnLookup" ToolTip="Fill this card from Scryfall"/>
                    </Grid>

                    <TextBlock Text="FRAME" Style="{StaticResource SectionLabel}"/>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}"
                                  DisplayMemberPath="Name"/>
                        <Button Grid.Column="1" Content="Import…" Style="{StaticResource Ghost}" Click="OnImportFrame"
                                Margin="6,0,0,0" ToolTip="Create a template from your own frame PNG (transparent where art shows)"/>
                    </Grid>

                    <TextBlock Text="ARTWORK" Style="{StaticResource SectionLabel}"/>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Change art…" Click="OnLoadArt"/>
                        <Button Grid.Column="1" Content="Paste" Click="OnPasteArt" Margin="6,0,0,0"
                                ToolTip="Paste an image, a copied image file, or an image URL from the clipboard"/>
                        <Button Grid.Column="2" Content="Clear" Style="{StaticResource Ghost}" Click="OnClearArt" Margin="6,0,0,0"/>
                    </Grid>
                    <TextBlock Text="Drop an image anywhere · drag the preview to pan · scroll to zoom" Foreground="{StaticResource Subtle}"
                               FontSize="11" Margin="2,0,0,18"/>

                    <Button Content="Edit details…" Click="OnEditDetails" Margin="0,0,0,16"/>

                    <Button Content="Export PNG…" Style="{StaticResource Primary}" Click="OnExport"/>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Copy image" Click="OnCopyImage"
                                ToolTip="Copy the finished card image to the clipboard"/>
                        <Button Grid.Column="1" Content="Open output folder" Click="OnOpenOutput" Margin="6,0,0,0"/>
                    </Grid>

                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <!-- ===== Preview ===== -->
            <Border Grid.Column="2" Background="#0F0F12" CornerRadius="10" Padding="18">
                <Grid>
                    <Image x:Name="PreviewImageControl" Source="{Binding PreviewImage}" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" Cursor="SizeAll"
                           MouseLeftButtonDown="OnPreviewMouseDown" MouseMove="OnPreviewMouseMove"
                           MouseLeftButtonUp="OnPreviewMouseUp" MouseWheel="OnPreviewWheel"/>
                    <ProgressBar VerticalAlignment="Bottom" Height="6" Minimum="0" Maximum="100"
                                 Value="{Binding ExportProgress}" Foreground="{StaticResource Accent}"
                                 Background="#26262B" BorderThickness="0"
                                 Visibility="{Binding IsExporting, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>

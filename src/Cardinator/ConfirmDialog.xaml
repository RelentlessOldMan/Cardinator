<Window x:Class="Cardinator.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cardinator" SizeToContent="Height" Width="460" MinWidth="380"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">
    <StackPanel Margin="22,20">
        <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBlock x:Name="MessageText" Foreground="{StaticResource Subtle}" FontSize="13"
                   TextWrapping="Wrap" Margin="0,0,0,18"/>
        <StackPanel x:Name="Buttons" Orientation="Horizontal" HorizontalAlignment="Right"/>
    </StackPanel>
</Window>

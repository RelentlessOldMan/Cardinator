<Window x:Class="Cardinator.DetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit card details" Height="760" Width="560" MinHeight="520" MinWidth="460"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterOwner"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True" ShowInTaskbar="False">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- header -->
        <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="22,16">
            <StackPanel>
                <TextBlock Text="Edit details" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Name}" Foreground="{StaticResource Subtle}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,18">
            <StackPanel>
                <TextBlock Text="Card text" Style="{StaticResource GroupHeader}"/>

                <TextBlock Text="Mana cost" Style="{StaticResource SectionLabel}"/>
                <TextBox Text="{Binding ManaCost, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"
                         ToolTip="e.g. {2}{R}{W} — or just type 2RW"/>

                <TextBlock Text="Type line" Style="{StaticResource SectionLabel}"/>
                <TextBox Text="{Binding TypeLine, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                <TextBlock Text="Rules text" Style="{StaticResource SectionLabel}"/>
                <TextBox Text="{Binding RulesText, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="150" Padding="12,8"
                         VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14"/>

                <TextBlock Text="Flavor text" Style="{StaticResource SectionLabel}"/>
                <TextBox Text="{Binding FlavorText, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="80" Padding="12,8"
                         VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Margin="0,0,0,20"/>

                <TextBlock Text="Stats" Style="{StaticResource GroupHeader}"/>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,7,0">
                        <TextBlock Text="Power" Style="{StaticResource SectionLabel}"/>
                        <TextBox Text="{Binding Power, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="3.5,0">
                        <TextBlock Text="Toughness" Style="{StaticResource SectionLabel}"/>
                        <TextBox Text="{Binding Toughness, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="7,0,0,0">
                        <TextBlock Text="Loyalty" Style="{StaticResource SectionLabel}"/>
                        <TextBox Text="{Binding Loyalty, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Printing" Style="{StaticResource GroupHeader}"/>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,7,0">
                        <TextBlock Text="Set code" Style="{StaticResource SectionLabel}"/>
                        <TextBox Text="{Binding SetCode, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="3.5,0">
                        <TextBlock Text="Number" Style="{StaticResource SectionLabel}"/>
                        <TextBox Text="{Binding CollectorNumber, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="7,0,0,0">
                        <TextBlock Text="Rarity" Style="{StaticResource SectionLabel}"/>
                        <TextBox Text="{Binding Rarity, UpdateSourceTrigger=PropertyChanged}" ToolTip="C / U / R / M"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Artist" Style="{StaticResource SectionLabel}"/>
                <TextBox Text="{Binding Artist, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                <TextBlock Text="Copyright / footer note" Style="{StaticResource SectionLabel}"/>
                <TextBox Text="{Binding Copyright, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,20"/>

                <TextBlock Text="Artwork position" Style="{StaticResource GroupHeader}"/>
                <TextBlock Text="Zoom" Style="{StaticResource SectionLabel}"/>
                <Slider Minimum="0.5" Maximum="3" Value="{Binding ArtScale}" Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,7,0">
                        <TextBlock Text="Pan X" Style="{StaticResource SectionLabel}"/>
                        <Slider Minimum="-0.5" Maximum="0.5" Value="{Binding ArtOffsetX}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="7,0,0,0">
                        <TextBlock Text="Pan Y" Style="{StaticResource SectionLabel}"/>
                        <Slider Minimum="-0.5" Maximum="0.5" Value="{Binding ArtOffsetY}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- footer -->
        <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="22,14">
            <Button Content="Done" Style="{StaticResource Primary}" MinWidth="110" HorizontalAlignment="Right" Click="OnDone"/>
        </Border>
    </Grid>
</Window>

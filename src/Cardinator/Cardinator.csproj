<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Cardinator</AssemblyName>
    <RootNamespace>Cardinator</RootNamespace>
    <!-- Version line is 1.6.x: bump the PATCH each batch (1.6.1, 1.6.2…), the MINOR only for big work agreed with the user.
         NEVER bump the major (2.0) — that is the user's decision alone. The app reads this at runtime
         (App.VersionNumber) so this is the single source of truth; never hardcode a version string. -->
    <Version>1.6.22</Version>
    <ApplicationIcon>Assets\cardinator.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- Publish settings (used by `dotnet publish`; dev builds stay framework-dependent & fast).
         Trimming is unsupported for WPF, so it stays off. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SharpVectors.Reloaded" Version="1.8.6" />
    <!-- Embedded Edge/Chromium engine used ONLY to fetch a Moxfield deck by URL with a real browser
         fingerprint + cookies (Cloudflare bot-blocks plain HTTP clients). Runs hidden/off-screen. The
         WebView2 Runtime ships with Windows 11 / modern Edge; if it's absent, URL import falls back to
         the paste flow. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <!-- Bundled sample artwork, extracted to CardinatorData/samples on first run so the starter
       cards (and the user) have real art to work with out of the box. -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\samples\*.png" />
    <!-- Bundled sample TEMPLATES (raster custom frames): each is a frame.png + template.json under
         Assets\templates\<slug>\, extracted to CardinatorData/templates on first run (see SampleTemplates).
         Ships the "Partial Cardboard Chemist" alchemy frames without any procedural drawing. -->
    <EmbeddedResource Include="Assets\templates\**\frame.png" />
    <EmbeddedResource Include="Assets\templates\**\template.json" />
    <!-- WPF resource so windows can load it for their title-bar icon via a pack URI. -->
    <Resource Include="Assets\cardinator.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cardinator.Tests" />
  </ItemGroup>

</Project>

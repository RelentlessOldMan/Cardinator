<Window x:Class="Cardinator.BulkEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set fields on all cards" SizeToContent="Height" Width="430" MinWidth="380"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">
    <StackPanel Margin="22,20">
        <TextBlock Text="Set fields on all cards" FontSize="15" FontWeight="SemiBold"/>
        <TextBlock Text="Blank fields are left unchanged. Applies to every card in the project."
                   Foreground="{StaticResource Subtle}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,14"/>

        <TextBlock Text="Set code" Style="{StaticResource SectionLabel}"/>
        <TextBox x:Name="SetBox" Height="34" Margin="0,2,0,10"/>

        <TextBlock Text="Artist" Style="{StaticResource SectionLabel}"/>
        <TextBox x:Name="ArtistBox" Height="34" Margin="0,2,0,10"/>

        <TextBlock Text="Copyright / footer" Style="{StaticResource SectionLabel}"/>
        <TextBox x:Name="CopyrightBox" Height="34" Margin="0,2,0,10"/>

        <TextBlock Text="Set symbol image (whole set shares it)" Style="{StaticResource SectionLabel}"/>
        <Grid Margin="0,2,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="SetSymbolBox" Height="34"/>
            <Button Grid.Column="1" Content="Browse…" Style="{StaticResource Ghost}" Click="OnBrowseSymbol" Margin="6,0,0,0"/>
        </Grid>

        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                <TextBlock Text="Rarity" Style="{StaticResource SectionLabel}"/>
                <ComboBox x:Name="RarityBox" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                <TextBlock Text="Frame" Style="{StaticResource SectionLabel}"/>
                <ComboBox x:Name="FrameBox" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>

        <TextBlock Text="Clear on all cards (empties the field)" Style="{StaticResource SectionLabel}" Margin="2,14,0,4"/>
        <WrapPanel>
            <CheckBox x:Name="ClearSet" Content="Set code" Margin="0,0,14,0"/>
            <CheckBox x:Name="ClearArtist" Content="Artist" Margin="0,0,14,0"/>
            <CheckBox x:Name="ClearCopyright" Content="Copyright / footer" Margin="0,0,14,0"/>
            <CheckBox x:Name="ClearSymbol" Content="Set symbol"/>
        </WrapPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" Style="{StaticResource Ghost}" MinWidth="90" Click="OnCancel" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Apply" Style="{StaticResource Primary}" MinWidth="110" Click="OnApply" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>

<Window x:Class="Cardinator.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cardinator" SizeToContent="Height" Width="480" MinWidth="380"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">
    <StackPanel Margin="22,20">
        <TextBlock x:Name="PromptText" Text="Enter a value" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBlock x:Name="HintText" Foreground="{StaticResource Subtle}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <TextBox x:Name="Entry" Height="36"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" Style="{StaticResource Ghost}" MinWidth="90" Click="OnCancel" Margin="0,0,8,0"/>
            <Button Content="OK" Style="{StaticResource Primary}" MinWidth="110" Click="OnOk" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>

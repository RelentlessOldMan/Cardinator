<Window x:Class="Cardinator.DeckListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import a deck list" Height="560" Width="560" MinHeight="440" MinWidth="460"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterOwner"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True" ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Import a deck" FontSize="15" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" TextWrapping="Wrap" Foreground="{StaticResource Subtle}" FontSize="12" Margin="0,4,0,10">
            <Run Text="Paste a"/>
            <Run Text="Moxfield deck link" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
            <Run Text="and Cardinator loads it for you — or paste an exported deck list (Moxfield"/>
            <Run Text="⋯ More → Export" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
            <Run Text=", Archidekt, MTGGoldfish, or plain text — one card per line, quantities and (SET) numbers welcome). Each card is filled from Scryfall with its art."/>
            <LineBreak/>
            <Run Text="Links from other deck sites can't be opened directly — export the list and paste it instead." Foreground="{StaticResource Warn}"/>
        </TextBlock>

        <TextBox Grid.Row="2" x:Name="DeckBox" AcceptsReturn="True" AcceptsTab="False"
                 TextWrapping="NoWrap" VerticalContentAlignment="Top" Padding="12,8"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="13"/>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" Foreground="{StaticResource Warn}" FontSize="12"
                       VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,220,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource Ghost}" MinWidth="90" Click="OnCancel" IsCancel="True"/>
                <Button Content="Import" Style="{StaticResource Primary}" MinWidth="110" Margin="10,0,0,0" Click="OnImport"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

<Window x:Class="Cardinator.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cardinator help" Height="720" Width="600" MinHeight="480" MinWidth="480"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterOwner"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True" ShowInTaskbar="False">

    <Window.Resources>
        <!-- Local helpers for the cheat-sheet body -->
        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
            <Setter Property="LineHeight" Value="19"/>
        </Style>
        <Style x:Key="Key" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="KeyDesc" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- header -->
        <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="22,16">
            <StackPanel>
                <TextBlock Text="Quick help" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock Text="Look up a card · swap in your art · export a PNG" Foreground="{StaticResource Subtle}" FontSize="12" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,18">
            <StackPanel>

                <TextBlock Text="Make a card" Style="{StaticResource GroupHeader}"/>
                <TextBlock Style="{StaticResource Body}"><Run Text="1."/>  Type a card name and press <Run FontWeight="SemiBold" Text="Ctrl+L"/> to auto-fill from Scryfall — or just type the fields yourself for an original card.</TextBlock>
                <TextBlock Style="{StaticResource Body}"><Run Text="2."/>  Pick a <Run FontWeight="SemiBold" Text="Frame"/> from the dropdown.</TextBlock>
                <TextBlock Style="{StaticResource Body}"><Run Text="3."/>  Add your <Run FontWeight="SemiBold" Text="artwork"/> (see below), then drag the preview to pan and scroll to zoom.</TextBlock>
                <TextBlock Style="{StaticResource Body}"><Run Text="4."/>  Open <Run FontWeight="SemiBold" Text="Edit details…"/> to change any field (rules, flavor, rarity, artist, stats).</TextBlock>
                <TextBlock Style="{StaticResource Body}"><Run Text="5."/>  <Run FontWeight="SemiBold" Text="Export PNG…"/> (1500×2100) or <Run FontWeight="SemiBold" Text="Copy image"/> to the clipboard.</TextBlock>

                <TextBlock Text="Adding artwork" Style="{StaticResource GroupHeader}" Margin="0,14,0,8"/>
                <TextBlock Style="{StaticResource Body}">• <Run FontWeight="SemiBold" Text="Change art…"/> — browse for an image file.</TextBlock>
                <TextBlock Style="{StaticResource Body}">• <Run FontWeight="SemiBold" Text="Paste"/> — a copied image, a copied image file, or an image URL from the clipboard.</TextBlock>
                <TextBlock Style="{StaticResource Body}">• <Run FontWeight="SemiBold" Text="Drag"/> an image file straight onto the window.</TextBlock>

                <TextBlock Text="Mana &amp; rules text" Style="{StaticResource GroupHeader}" Margin="0,14,0,8"/>
                <TextBlock Style="{StaticResource Body}">Mana uses tokens like <Run FontFamily="Consolas" Text="{}{2}{R}{W}"/>, <Run FontFamily="Consolas" Text="{}{X}"/>, <Run FontFamily="Consolas" Text="{}{T}"/> (tap), hybrids <Run FontFamily="Consolas" Text="{}{R/W}"/>. Typing loosely (<Run FontFamily="Consolas" Text="2RW"/>) works too.</TextBlock>
                <TextBlock Style="{StaticResource Body}">Rules text understands the same <Run FontFamily="Consolas" Text="{}{...}"/> symbols inline. Press Enter for a new ability on its own line. Long text auto-shrinks to fit.</TextBlock>

                <TextBlock Text="Special card types (automatic)" Style="{StaticResource GroupHeader}" Margin="0,14,0,8"/>
                <TextBlock Style="{StaticResource Body}">• <Run FontWeight="SemiBold" Text="Planeswalker"/> — type line says Planeswalker + set Loyalty → loyalty box &amp; ability badges (+2:, -3:).</TextBlock>
                <TextBlock Style="{StaticResource Body}">• <Run FontWeight="SemiBold" Text="Saga"/> — type line says Saga → chapter markers (I, II, III).</TextBlock>
                <TextBlock Style="{StaticResource Body}">• <Run FontWeight="SemiBold" Text="Class"/> — type line says Class → level badges.</TextBlock>
                <TextBlock Style="{StaticResource Body}">• <Run FontWeight="SemiBold" Text="Adventure"/> — fill the Adventure fields → a spell sub-box on the creature.</TextBlock>
                <TextBlock Style="{StaticResource Body}">• <Run FontWeight="SemiBold" Text="Battle / Plane"/> — printed sideways, automatically, on any drawn frame. Set a Battle's <Run FontWeight="SemiBold" Text="Defense"/> in Edit details… (drawn in a shield). Force any card upright or sideways with <Run FontWeight="SemiBold" Text="Orientation"/> there too.</TextBlock>
                <TextBlock Style="{StaticResource Body}">• <Run FontWeight="SemiBold" Text="Flip card"/> — two halves on one face, the other half upside down below the art (Kamigawa). Looking up a real one brings both halves; or click <Run FontWeight="SemiBold" Text="Make flip card"/>, then <Run FontWeight="SemiBold" Text="Edit flipped half…"/> and <Run FontWeight="SemiBold" Text="Show flipped"/> to turn the preview over. Works on every drawn frame and the Partial Cardboard Chemist frames.</TextBlock>
                <TextBlock Style="{StaticResource Body}">• <Run FontWeight="SemiBold" Text="Split card"/> — two small cards side by side, read sideways (Wear // Tear, Rooms). Looking up a real one brings both halves with their own art; or click <Run FontWeight="SemiBold" Text="Make split card"/>, then <Run FontWeight="SemiBold" Text="Edit other half…"/>. Click a half in the preview to give it art or move its art; <Run FontWeight="SemiBold" Text="Read sideways"/> turns the preview. A shared Fuse / Room reminder is printed once across both halves. Works on every frame.</TextBlock>
                <TextBlock Style="{StaticResource Body}">• <Run FontWeight="SemiBold" Text="Double-faced"/> — one card with two faces. Looking up a real double-faced card brings both sides; or click <Run FontWeight="SemiBold" Text="Make double-faced"/>, then <Run FontWeight="SemiBold" Text="Edit back face…"/> to fill it in and <Run FontWeight="SemiBold" Text="Show back"/> to flip the preview. Pick a corner indicator (flip arrow or sun/moon). Export writes both sides, and a double-sided print sheet pairs the real back.</TextBlock>

                <TextBlock Text="Keyboard shortcuts" Style="{StaticResource GroupHeader}" Margin="0,14,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource Key}" Text="Ctrl+N"/>
                        <TextBlock Style="{StaticResource Key}" Text="Ctrl+O"/>
                        <TextBlock Style="{StaticResource Key}" Text="Ctrl+S"/>
                        <TextBlock Style="{StaticResource Key}" Text="Ctrl+L"/>
                        <TextBlock Style="{StaticResource Key}" Text="Ctrl+E"/>
                        <TextBlock Style="{StaticResource Key}" Text="Ctrl+D"/>
                        <TextBlock Style="{StaticResource Key}" Text="Ctrl+Z"/>
                        <TextBlock Style="{StaticResource Key}" Text="Ctrl+Y"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource KeyDesc}" Text="New project"/>
                        <TextBlock Style="{StaticResource KeyDesc}" Text="Open project"/>
                        <TextBlock Style="{StaticResource KeyDesc}" Text="Save (same file after first save)"/>
                        <TextBlock Style="{StaticResource KeyDesc}" Text="Look up current card"/>
                        <TextBlock Style="{StaticResource KeyDesc}" Text="Export current card"/>
                        <TextBlock Style="{StaticResource KeyDesc}" Text="Duplicate current card"/>
                        <TextBlock Style="{StaticResource KeyDesc}" Text="Undo"/>
                        <TextBlock Style="{StaticResource KeyDesc}" Text="Redo (also Ctrl+Shift+Z)"/>
                    </StackPanel>
                </Grid>
                <TextBlock Style="{StaticResource Body}" Margin="0,4,0,0">The title bar shows <Run FontWeight="SemiBold" Text="●"/> when you have unsaved changes; Cardinator asks before you lose work. Every edit is undoable with Ctrl+Z / Ctrl+Y.</TextBlock>

                <TextBlock Text="The CHECKS panel" Style="{StaticResource GroupHeader}" Margin="0,14,0,8"/>
                <TextBlock Style="{StaticResource Body}">Below the preview, CHECKS watches the selected card and flags problems before export — missing art, an unknown <Run FontFamily="Consolas" Text="{}{symbol}"/>, a footer overlapping the text box, a region off the card, or a collector number used twice. "<Run Text="✓ No issues"/>" means you're clear.</TextBlock>

                <TextBlock Text="Many cards at once" Style="{StaticResource GroupHeader}" Margin="0,14,0,8"/>
                <TextBlock Style="{StaticResource Body}">Use the <Run FontWeight="SemiBold" Text="Batch"/> section: <Run FontWeight="SemiBold" Text="Import file…"/> (names or a spreadsheet), <Run FontWeight="SemiBold" Text="Import deck…"/> (a Moxfield deck URL or a pasted list), <Run FontWeight="SemiBold" Text="Add art from folder…"/>, <Run FontWeight="SemiBold" Text="Fill blanks from Scryfall"/>, <Run FontWeight="SemiBold" Text="Check all cards"/>, <Run FontWeight="SemiBold" Text="Export all…"/>, and <Run FontWeight="SemiBold" Text="Print sheet"/> (3×3 at real size; it can add card backs for double-sided printing). Save the whole set as one project file.</TextBlock>
                <TextBlock Style="{StaticResource Body}"><Run FontWeight="SemiBold" Text="Number cards"/> auto-numbers the set (001/N, 002/N…), and <Run FontWeight="SemiBold" Text="Set fields on all…"/> bulk-edits the set code, artist, rarity, copyright, frame and set-symbol image across every card at once.</TextBlock>

                <TextBlock Text="If something goes wrong" Style="{StaticResource GroupHeader}" Margin="0,14,0,8"/>
                <TextBlock Style="{StaticResource Body}">Your work is protected three ways: saves are atomic (a crash mid-save can’t truncate a good file), every save keeps the previous version in a <Run FontFamily="Consolas" Text="backups"/> folder (the last 15) — click <Run FontWeight="SemiBold" Text="Restore…"/> to roll one back, then <Run FontWeight="SemiBold" Text="Save"/> to put it in place — and an unreadable project file is preserved rather than lost. The title bar shows <Run Text="●"/> while you have unsaved changes, and the version number is in the header and the title bar when you report a problem.</TextBlock>

                <TextBlock Text="Where your files live" Style="{StaticResource GroupHeader}" Margin="0,14,0,8"/>
                <TextBlock Style="{StaticResource Body}">A saved set is its own folder: the project file plus <Run FontFamily="Consolas" Text="art"/> (your images, copied in) and <Run FontFamily="Consolas" Text="out"/> (where Export and Print sheet default) — move, zip or share the folder and every card still finds its art. Shared files live in <Run FontFamily="Consolas" Text="CardinatorData"/> next to the app: frames in <Run FontFamily="Consolas" Text="templates"/>, cached symbols in <Run FontFamily="Consolas" Text="symbols"/>. Move the app + that folder together to keep everything.</TextBlock>

            </StackPanel>
        </ScrollViewer>

        <!-- footer -->
        <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="22,14">
            <Grid>
                <TextBlock x:Name="VersionText" Text="Cardinator" Foreground="{StaticResource Subtle}" FontSize="12" VerticalAlignment="Center"/>
                <Button Content="Close" Style="{StaticResource Primary}" MinWidth="110" HorizontalAlignment="Right" Click="OnClose" IsCancel="True" IsDefault="True"/>
            </Grid>
        </Border>
    </Grid>
</Window>

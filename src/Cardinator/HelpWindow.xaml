<Window x:Class="Cardinator.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cardinator help" Height="720" Width="600" MinHeight="480" MinWidth="480"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterOwner"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True" ShowInTaskbar="False">

    <Window.Resources>
        <!-- Local helpers for the cheat-sheet body -->
        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
            <Setter Property="LineHeight" Value="19"/>
        </Style>
        <Style x:Key="Key" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="KeyDesc" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- header -->
        <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="22,16">
            <StackPanel>
                <TextBlock Text="Quick help" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock Text="Look up a card · swap in your art · export a PNG" Foreground="{StaticResource Subtle}" FontSize="12" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,18">
            <StackPanel>

                <TextBlock Text="Make a card" Style="{StaticResource GroupHeader}"/>
                <TextBlock Style="{StaticResource Body}"><Run Text="1."/>  Type a card name. For a real card, click <Run FontWeight="SemiBold" Text="Look up"/> beside it (or press <Run FontWeight="SemiBold" Text="Ctrl+L"/>): it becomes that card — cost, type, rules, power/toughness and, unless it has your own, its art — from Scryfall, keeping your frame. For an original card, fill in TYPE LINE, MANA COST and RULES TEXT yourself.</TextBlock>
                <TextBlock Style="{StaticResource Body}"><Run Text="2."/>  Pick a <Run FontWeight="SemiBold" Text="Frame"/> from the dropdown.</TextBlock>
                <TextBlock Style="{StaticResource Body}"><Run Text="3."/>  Add your <Run FontWeight="SemiBold" Text="artwork"/> (see below), then drag the preview to pan and scroll to zoom. Click the preview to use the keys: arrows nudge, + / − zoom, 0 resets. <Run FontWeight="SemiBold" Text="Reset"/> puts the art back centred at its original size.</TextBlock>
                <TextBlock Style="{StaticResource Body}"><Run Text="4."/>  Open <Run FontWeight="SemiBold" Text="Edit details…"/> for the rest: power/toughness, flavor, rarity, set, artist and more — and Fill from Scryfall, which borrows a real card's stats but keeps your card's name.</TextBlock>
                <TextBlock Style="{StaticResource Body}"><Run Text="5."/>  Under the preview: <Run FontWeight="SemiBold" Text="Export PNG…"/> (1500×2100) or <Run FontWeight="SemiBold" Text="Copy image"/> to the clipboard.</TextBlock>

                <TextBlock Text="The card layout and its two sides" Style="{StaticResource GroupHeader}" Margin="0,14,0,8"/>
                <TextBlock Style="{StaticResource Body}"><Run FontWeight="SemiBold" Text="Card layout"/> says what kind of card it is: Normal, Double-faced, Meld, Flip, Split or Adventure. Pick one and the card changes there and then; whatever the new layout uses is kept (a back face going from double-faced to meld, the other half going from flip to split), and if something you wrote would be lost it asks first — Undo brings it back. The one row under the dropdown holds that layout's options.</TextBlock>
                <TextBlock Style="{StaticResource Body}"><Run FontWeight="SemiBold" Text="Front | Back"/> above the preview picks the side you see — and the side the editing column changes: the name, the frame, the art and <Run FontWeight="SemiBold" Text="Edit details…"/> all follow it. A double-faced card's back is its back face; a meld card's back is the melded card. Every other card's back is the set's <Run FontWeight="SemiBold" Text="card back"/>, which you choose in <Run FontWeight="SemiBold" Text="Set settings…"/>. A flip or split card also gets a half switch (<Run FontWeight="SemiBold" Text="Top half | Flipped half"/> or <Run FontWeight="SemiBold" Text="First half | Second half"/>).</TextBlock>

                <TextBlock Text="Adding artwork" Style="{StaticResource GroupHeader}" Margin="0,14,0,8"/>
                <TextBlock Style="{StaticResource Body}">• <Run FontWeight="SemiBold" Text="Change art…"/> — browse for an image file.</TextBlock>
                <TextBlock Style="{StaticResource Body}">• <Run FontWeight="SemiBold" Text="Paste"/> — a copied image, a copied image file, or an image URL from the clipboard.</TextBlock>
                <TextBlock Style="{StaticResource Body}">• <Run FontWeight="SemiBold" Text="Drag"/> an image file straight onto the window. (Drop a .cardframe there to install a shared frame.)</TextBlock>

                <TextBlock Text="Mana &amp; rules text" Style="{StaticResource GroupHeader}" Margin="0,14,0,8"/>
                <TextBlock Style="{StaticResource Body}">Mana uses tokens like <Run FontFamily="Consolas" Text="{}{2}{R}{W}"/>, <Run FontFamily="Consolas" Text="{}{X}"/>, <Run FontFamily="Consolas" Text="{}{T}"/> (tap), hybrids <Run FontFamily="Consolas" Text="{}{R/W}"/>. Typing loosely (<Run FontFamily="Consolas" Text="2RW"/>) works too.</TextBlock>
                <TextBlock Style="{StaticResource Body}">Rules text understands the same <Run FontFamily="Consolas" Text="{}{...}"/> symbols inline. Press Enter for a new ability on its own line. Long text auto-shrinks to fit.</TextBlock>

                <TextBlock Text="Special card types (automatic)" Style="{StaticResource GroupHeader}" Margin="0,14,0,8"/>
                <TextBlock Style="{StaticResource Body}">• <Run FontWeight="SemiBold" Text="Planeswalker"/> — type line says Planeswalker + set Loyalty → loyalty box &amp; ability badges (+2:, -3:).</TextBlock>
                <TextBlock Style="{StaticResource Body}">• <Run FontWeight="SemiBold" Text="Saga"/> — type line says Saga → chapter markers (I, II, III).</TextBlock>
                <TextBlock Style="{StaticResource Body}">• <Run FontWeight="SemiBold" Text="Class"/> — type line says Class → level badges.</TextBlock>
                                <TextBlock Style="{StaticResource Body}">• <Run FontWeight="SemiBold" Text="Adventure"/> — pick it as the Card layout (or fill the Adventure fields in Edit details…) → a storybook text box: the spell on the left page (its name bar, type and rules), the creature's rules on the right, both at the same size.</TextBlock>
                <TextBlock Style="{StaticResource Body}">• <Run FontWeight="SemiBold" Text="Battle / Plane"/> — printed sideways, automatically, on any drawn frame. Set a Battle's <Run FontWeight="SemiBold" Text="Defense"/> in Edit details… (drawn in a shield). Force any card upright or sideways with <Run FontWeight="SemiBold" Text="Orientation"/> there too.</TextBlock>
                                <TextBlock Style="{StaticResource Body}">• <Run FontWeight="SemiBold" Text="Flip card"/> — two halves on one face, the other half upside down below the art (Kamigawa). Looking up a real one brings both halves; or pick <Run FontWeight="SemiBold" Text="Flip"/> as the Card layout, then <Run FontWeight="SemiBold" Text="Flipped half"/> above the preview to turn it over and write that half. Works on every drawn frame and the Partial Cardboard Chemist frames.</TextBlock>
                                <TextBlock Style="{StaticResource Body}">• <Run FontWeight="SemiBold" Text="Meld"/> — two cards whose backs, side by side, make one big melded card. Pick <Run FontWeight="SemiBold" Text="Meld"/> as the Card layout: its <Run FontWeight="SemiBold" Text="Back"/> is the melded card. <Run FontWeight="SemiBold" Text="Its back shows the"/> top or bottom half picks which half this card prints; <Run FontWeight="SemiBold" Text="Add partner"/> adds the other card; <Run FontWeight="SemiBold" Text="Show the whole melded card"/> (on Back) previews it whole. Edits reach both cards; looked-up meld cards come in ready.</TextBlock>
                <TextBlock Style="{StaticResource Body}">• <Run FontWeight="SemiBold" Text="Station"/> — write the thresholds the way Scryfall does: <Run FontWeight="SemiBold" Text="3+ | Whenever…"/>, <Run FontWeight="SemiBold" Text="12+ | Flying"/>. Each gets a band with its number in a badge; the P/T box goes on the band where it becomes a creature. <Run FontWeight="SemiBold" Text="Case"/> — lines starting <Run FontWeight="SemiBold" Text="To solve —"/> and <Run FontWeight="SemiBold" Text="Solved —"/> get their own bands, with a magnifying glass and a check mark.</TextBlock>
                <TextBlock Style="{StaticResource Body}">• <Run FontWeight="SemiBold" Text="Level up"/> — write the levels the way Scryfall does: a line <Run FontWeight="SemiBold" Text="LEVEL 2-6"/>, then <Run FontWeight="SemiBold" Text="3/3"/>, then that level's rules (and <Run FontWeight="SemiBold" Text="LEVEL 7+"/> for the last). The text box becomes level bands, each with a LEVEL badge and its own P/T box; looked-up levelers come in ready.</TextBlock>
                <TextBlock Style="{StaticResource Body}">• <Run FontWeight="SemiBold" Text="Prototype / Mutate"/> — start the rules with <Run FontWeight="SemiBold" Text="Prototype {2}{R} — 3/2 (…)"/> or <Run FontWeight="SemiBold" Text="Mutate {1}{G}{G} (…)"/>: that line becomes a band across the top of the text box (a prototype's in its cost's colour, with its own cost and P/T).</TextBlock>
                                <TextBlock Style="{StaticResource Body}">• <Run FontWeight="SemiBold" Text="Split card"/> — two small cards side by side, read sideways (Wear // Tear, Rooms). Looking up a real one brings both halves with their own art; or pick <Run FontWeight="SemiBold" Text="Split"/> as the Card layout, then <Run FontWeight="SemiBold" Text="Second half"/> above the preview (or click that half) to write it and give it art; <Run FontWeight="SemiBold" Text="Read sideways"/> turns the preview. A shared Fuse / Room reminder is printed once across both halves, each end in its half's colour. Works on every frame, and <Run FontWeight="SemiBold" Text="Second half&apos;s frame"/> gives that half a frame of its own. Start the second half's rules with <Run FontWeight="SemiBold" Text="Aftermath"/> and it becomes an aftermath card: the first half upright across the top, the other half sideways below.</TextBlock>
                                <TextBlock Style="{StaticResource Body}">• <Run FontWeight="SemiBold" Text="Tokens &amp; emblems"/> — start the type line with <Run FontWeight="SemiBold" Text="Token"/> or <Run FontWeight="SemiBold" Text="Emblem"/> (<Run FontWeight="SemiBold" Text="Token Creature — Soldier"/>), or pick <Run FontWeight="SemiBold" Text="New card ▾ → Token"/>: tall art, the name centred, and a text box that fits the rules (none on a vanilla token). They export and print with the rest of the set. Works on every frame, picture frames too.</TextBlock>
                                <TextBlock Style="{StaticResource Body}">• <Run FontWeight="SemiBold" Text="Double-faced"/> — one card with two faces. Looking up a real double-faced card brings both sides; or pick <Run FontWeight="SemiBold" Text="Double-faced"/> as the Card layout, then <Run FontWeight="SemiBold" Text="Back"/> above the preview to write the back face. <Run FontWeight="SemiBold" Text="Corner mark"/> picks the symbol in the corner (flip arrow or sun/moon). Export writes both sides, and a double-sided print sheet pairs the real back.</TextBlock>

                <TextBlock Text="Keyboard shortcuts" Style="{StaticResource GroupHeader}" Margin="0,14,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource Key}" Text="Ctrl+N"/>
                        <TextBlock Style="{StaticResource Key}" Text="Ctrl+O"/>
                        <TextBlock Style="{StaticResource Key}" Text="Ctrl+S"/>
                        <TextBlock Style="{StaticResource Key}" Text="Ctrl+Shift+S"/>
                        <TextBlock Style="{StaticResource Key}" Text="Ctrl+L"/>
                        <TextBlock Style="{StaticResource Key}" Text="Ctrl+E"/>
                        <TextBlock Style="{StaticResource Key}" Text="Ctrl+D"/>
                        <TextBlock Style="{StaticResource Key}" Text="Ctrl+Z"/>
                        <TextBlock Style="{StaticResource Key}" Text="Ctrl+Y"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource KeyDesc}" Text="New project"/>
                        <TextBlock Style="{StaticResource KeyDesc}" Text="Open project"/>
                        <TextBlock Style="{StaticResource KeyDesc}" Text="Save (same file after first save)"/>
                        <TextBlock Style="{StaticResource KeyDesc}" Text="Save as… (another name or folder)"/>
                        <TextBlock Style="{StaticResource KeyDesc}" Text="Look up: make it the real card with this name"/>
                        <TextBlock Style="{StaticResource KeyDesc}" Text="Export current card"/>
                        <TextBlock Style="{StaticResource KeyDesc}" Text="Duplicate current card"/>
                        <TextBlock Style="{StaticResource KeyDesc}" Text="Undo"/>
                        <TextBlock Style="{StaticResource KeyDesc}" Text="Redo (also Ctrl+Shift+Z)"/>
                    </StackPanel>
                </Grid>
                <TextBlock Style="{StaticResource Body}" Margin="0,4,0,0">The title bar shows <Run FontWeight="SemiBold" Text="●"/> when you have unsaved changes; Cardinator asks before you lose work. Every edit is undoable with Ctrl+Z / Ctrl+Y.</TextBlock>

                <TextBlock Text="The CHECKS panel" Style="{StaticResource GroupHeader}" Margin="0,14,0,8"/>
                <TextBlock Style="{StaticResource Body}">At the bottom of the editing column, CHECKS watches the selected card and flags problems before export — an unknown <Run FontFamily="Consolas" Text="{}{symbol}"/>, a footer overlapping the text box, a region off the card, rules text too long for its box, or a collector number used twice. Notes (ℹ) point out things that may be on purpose, like a card with no art yet. "<Run Text="✓ No issues"/>" means you're clear.</TextBlock>

                <TextBlock Text="Many cards at once" Style="{StaticResource GroupHeader}" Margin="0,14,0,8"/>
                                <TextBlock Style="{StaticResource Body}"><Run FontWeight="SemiBold" Text="ADD MANY CARDS"/>: <Run FontWeight="SemiBold" Text="Import cards…"/> (a Moxfield deck link, a list file — names or a spreadsheet — or a pasted list), <Run FontWeight="SemiBold" Text="Search Scryfall…"/>, <Run FontWeight="SemiBold" Text="Art from folder…"/> (pictures named after the cards) and <Run FontWeight="SemiBold" Text="Fill in blanks"/> (looks up every card that has only a name). <Run FontWeight="SemiBold" Text="EXPORT"/>: <Run FontWeight="SemiBold" Text="All as images…"/>, <Run FontWeight="SemiBold" Text="Print sheets…"/> (3×3 at real size, with the card backs for double-sided printing). <Run FontWeight="SemiBold" Text="Share the set…"/> (under WHOLE SET) makes one .zip to send someone. Save writes the set as its own folder — saved into a folder that already holds other things, it makes one named after the set.</TextBlock>
                                <TextBlock Style="{StaticResource Body}"><Run FontWeight="SemiBold" Text="WHOLE SET"/>: <Run FontWeight="SemiBold" Text="Set settings…"/> holds what every card shares — set code, rarity, artist, copyright line, set symbol, the frame for new cards and the card back — and whether those reach only new cards, fill in blanks on the cards already here, or replace theirs. <Run FontWeight="SemiBold" Text="Number cards"/> numbers the set in list order, padded to its size (1/9 for 9 cards, 01/12 for 12, 001/120 for 120); <Run FontWeight="SemiBold" Text="Check all cards"/> lists every card that needs attention.</TextBlock>

                <TextBlock Text="If something goes wrong" Style="{StaticResource GroupHeader}" Margin="0,14,0,8"/>
                <TextBlock Style="{StaticResource Body}">Your work is protected four ways: saves are atomic (a crash mid-save can’t truncate a good file), every save keeps the previous version in a <Run FontFamily="Consolas" Text="backups"/> folder (the last 15, plus the first of each of the last 30 days) — click <Run FontWeight="SemiBold" Text="Restore…"/> to roll one back, then <Run FontWeight="SemiBold" Text="Save"/> to put it in place — an unreadable project file is preserved rather than lost, and while you have unsaved changes a recovery copy is kept every minute (and when Windows shuts down), which the next launch offers to open. The title bar shows <Run Text="●"/> while you have unsaved changes, and the version number is in the header and the title bar when you report a problem.</TextBlock>

                <TextBlock Text="Where your files live" Style="{StaticResource GroupHeader}" Margin="0,14,0,8"/>
                <TextBlock Style="{StaticResource Body}">A saved set is its own folder: the project file plus <Run FontFamily="Consolas" Text="art"/> (your images, copied in) and <Run FontFamily="Consolas" Text="out"/> (where Export and Print sheets default) — move, zip or share the folder and every card still finds its art. Shared files live in <Run FontFamily="Consolas" Text="CardinatorData"/> next to the app (or in <Run FontFamily="Consolas" Text="%APPDATA%\Cardinator"/> when the app's folder can't be written to): frames in <Run FontFamily="Consolas" Text="templates"/>, cached symbols in <Run FontFamily="Consolas" Text="symbols"/>. Move the app + that folder together to keep everything. Save each set into a folder of its own.</TextBlock>

            </StackPanel>
        </ScrollViewer>

        <!-- footer -->
        <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="22,14">
            <Grid>
                <TextBlock x:Name="VersionText" Text="Cardinator" Foreground="{StaticResource Subtle}" FontSize="12" VerticalAlignment="Center"/>
                <Button Content="Close" Style="{StaticResource Primary}" MinWidth="110" HorizontalAlignment="Right" Click="OnClose" IsCancel="True" IsDefault="True"/>
            </Grid>
        </Border>
    </Grid>
</Window>

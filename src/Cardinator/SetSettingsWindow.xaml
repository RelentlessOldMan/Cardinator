<Window x:Class="Cardinator.SetSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set settings" SizeToContent="Height" Width="760" MinWidth="700"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">
    <StackPanel Margin="22,20">
        <TextBlock Text="Set settings" FontSize="15" FontWeight="SemiBold"/>
        <TextBlock Text="What every card in this set shares: its printing details and the back of its cards."
                   Foreground="{StaticResource Subtle}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,14"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- ===== The set's printing details ===== -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="PRINTING DETAILS" Style="{StaticResource SectionLabel}"/>
                <Grid Margin="0,2,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock Text="Set code" Foreground="{StaticResource Subtle}" FontSize="12"/>
                        <TextBox x:Name="SetBox" Height="32" Margin="0,2,0,0" TextChanged="OnAnyChange"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                        <TextBlock Text="Rarity" Foreground="{StaticResource Subtle}" FontSize="12"/>
                        <ComboBox x:Name="RarityBox" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Artist" Foreground="{StaticResource Subtle}" FontSize="12"/>
                <TextBox x:Name="ArtistBox" Height="32" Margin="0,2,0,10"/>

                <TextBlock Text="Copyright line" Foreground="{StaticResource Subtle}" FontSize="12"/>
                <TextBox x:Name="CopyrightBox" Height="32" Margin="0,2,0,10"/>

                <TextBlock Text="Set symbol (an image)" Foreground="{StaticResource Subtle}" FontSize="12"/>
                <Grid Margin="0,2,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="SetSymbolBox" Height="32" TextChanged="OnAnyChange"/>
                    <Button Grid.Column="1" Content="Browse…" Style="{StaticResource Ghost}" Click="OnBrowseSymbol" Margin="6,0,0,0"/>
                </Grid>

                <TextBlock Text="Frame for new cards" Foreground="{StaticResource Subtle}" FontSize="12"/>
                <ComboBox x:Name="FrameBox" Margin="0,2,0,14"/>

                <TextBlock Text="USE THESE FOR" Style="{StaticResource SectionLabel}"/>
                <RadioButton x:Name="ModeNew" GroupName="Mode" IsChecked="True" Margin="2,4,0,4" Checked="OnModeChanged"
                             Content="New and imported cards only"/>
                <RadioButton x:Name="ModeFill" GroupName="Mode" Margin="2,4,0,4" Checked="OnModeChanged"
                             Content="…and fill in the cards already here that leave them blank"/>
                <RadioButton x:Name="ModeReplace" GroupName="Mode" Margin="2,4,0,4" Checked="OnModeChanged"
                             Content="…and replace them on every card already here"/>
                <StackPanel x:Name="ReplacePanel" Margin="24,2,0,0" Visibility="Collapsed">
                    <CheckBox x:Name="OnlySelectedBox" Margin="0,2,0,6" Visibility="Collapsed"/>
                    <TextBlock Text="A blank field above leaves the cards' own value. To empty it on them, tick it here:"
                               Foreground="{StaticResource Subtle}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <WrapPanel>
                        <CheckBox x:Name="ClearSetBox" Content="Set code" Margin="0,0,12,0"/>
                        <CheckBox x:Name="ClearArtistBox" Content="Artist" Margin="0,0,12,0"/>
                        <CheckBox x:Name="ClearCopyrightBox" Content="Copyright" Margin="0,0,12,0"/>
                        <CheckBox x:Name="ClearSymbolBox" Content="Set symbol"/>
                    </WrapPanel>
                </StackPanel>
            </StackPanel>

            <!-- ===== The card back ===== -->
            <StackPanel Grid.Column="2">
                <TextBlock Text="CARD BACK" Style="{StaticResource SectionLabel}"/>
                <TextBlock Text="The back of every card that doesn't have a back face of its own — what your cards show face down."
                           Foreground="{StaticResource Subtle}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource PreviewBg}" CornerRadius="6" Padding="4" VerticalAlignment="Top">
                        <Image x:Name="BackPreview" Stretch="Uniform" Height="158" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <RadioButton x:Name="BackDefault" GroupName="Back" Content="Cardinator's" Margin="0,2,0,6" Checked="OnAnyChange"/>
                        <RadioButton x:Name="BackDesigned" GroupName="Back" Content="Designed for this set" Margin="0,2,0,6" Checked="OnAnyChange"/>
                        <RadioButton x:Name="BackPicture" GroupName="Back" Content="My own picture" Margin="0,2,0,6" Checked="OnAnyChange"/>
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="DesignedPanel" Margin="0,12,0,0" Visibility="Collapsed">
                    <TextBlock Text="Words under the emblem (blank: the set's name)" Foreground="{StaticResource Subtle}" FontSize="12"/>
                    <TextBox x:Name="WordmarkBox" Height="32" Margin="0,2,0,8" TextChanged="OnAnyChange"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Colour" Foreground="{StaticResource Subtle}" FontSize="12"/>
                            <TextBox x:Name="BackColorBox" Height="32" Margin="0,2,0,0" TextChanged="OnAnyChange"
                                     ToolTip="A colour like #1F2A44 or a name like navy"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="Trim" Foreground="{StaticResource Subtle}" FontSize="12"/>
                            <TextBox x:Name="BackAccentBox" Height="32" Margin="0,2,0,0" TextChanged="OnAnyChange"
                                     ToolTip="The lines, the emblem's edge and the words: a colour like #C9A24B or a name like gold"/>
                        </StackPanel>
                    </Grid>
                    <CheckBox x:Name="UseSymbolBox" Content="Use the set symbol as the emblem" Checked="OnAnyChange" Unchecked="OnAnyChange"/>
                </StackPanel>

                <StackPanel x:Name="PicturePanel" Margin="0,12,0,0" Visibility="Collapsed">
                    <TextBlock Text="Picture (fills the card)" Foreground="{StaticResource Subtle}" FontSize="12"/>
                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="BackImageBox" Height="32" TextChanged="OnAnyChange"/>
                        <Button Grid.Column="1" Content="Browse…" Style="{StaticResource Ghost}" Click="OnBrowseBack" Margin="6,0,0,0"/>
                    </Grid>
                </StackPanel>

                <Button Content="Save the card back as an image…" Style="{StaticResource Ghost}" Click="OnExportBack" Margin="0,14,0,0"
                        ToolTip="Writes the card back as a PNG, for printing the backs of your cards"/>
            </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" Style="{StaticResource Ghost}" MinWidth="90" Click="OnCancel" Margin="0,0,8,0" IsCancel="True"/>
            <Button x:Name="SaveButton" Content="Save" Style="{StaticResource Primary}" MinWidth="110" Click="OnApply" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
